// 2026-02-14 Generated by IBM Bob
// Cleanup orphaned container images from local registry
@Library("ceph-qe-libs@main") _

pipeline {
    agent { label "infra" }

    options {
        buildDiscarder(logRotator(numToKeepStr: "30", daysToKeepStr: "90"))
        timestamps()
        timeout(time: 2, unit: 'HOURS')
    }

    stages {
        stage("Validate Input") {
            steps {
                script {
                    echo "=== Input Parameters ==="
                    echo "Manifest Branch: main (fixed)"
                    echo "Release Version: All available releases"
                    echo "Repositories: rh-stage, ibm-stage (fixed)"
                    echo "Dry Run: ${params.DRY_RUN}"
                    echo "Force Cleanup: ${params.FORCE_CLEANUP}"
                    echo "Skip GC: ${params.SKIP_GC}"
                    echo "========================"

                    // Warning for non-DRY_RUN mode
                    if (!params.DRY_RUN) {
                        echo "\n⚠️  WARNING: DRY_RUN is disabled. Images will be PERMANENTLY DELETED!"
                        echo "⚠️  This action cannot be undone."
                        echo "⚠️  Please ensure you have reviewed the orphan list first.\n"
                    }
                }
            }
        }

        stage("Cleanup Registry Images") {
            steps {
                script {
                    echo "\n=== Starting Registry Cleanup ==="
                    
                    try {
                        // Call the main cleanup function with fixed values
                        cleanupRegistryImages(
                            dryRun: params.DRY_RUN,
                            forceCleanup: params.FORCE_CLEANUP,
                            skipGC: params.SKIP_GC
                        )
                        
                        echo "\n✓ Registry cleanup completed successfully"
                        
                    } catch (Exception e) {
                        echo "\n✗ Registry cleanup failed: ${e.getMessage()}"
                        currentBuild.result = "FAILURE"
                        throw e
                    }
                }
            }
        }

        stage("Summary") {
            steps {
                script {
                    echo "\n=== Cleanup Summary ==="
                    echo "Build Status: ${currentBuild.result ?: 'SUCCESS'}"
                    echo "Release Version: All available releases"
                    echo "Repositories: rh-stage, ibm-stage"
                    echo "Dry Run: ${params.DRY_RUN}"
                    
                    if (params.DRY_RUN) {
                        echo "\n✓ This was a DRY RUN. No images were actually deleted."
                        echo "  Review the orphan list above and run with DRY_RUN=false to perform cleanup."
                    } else {
                        echo "\n✓ Images have been deleted from registry."
                        if (!params.SKIP_GC) {
                            echo "✓ Garbage collection has been triggered."
                            echo "  Disk space will be freed after GC completes."
                        } else {
                            echo "⚠️  Garbage collection was skipped."
                            echo "  Disk space will not be freed until GC is run manually."
                        }
                    }
                    echo "===================="
                }
            }
        }
    }

    post {
        success {
            script {
                echo "\n✓ Pipeline completed successfully"
                if (params.DRY_RUN) {
                    echo "  Next step: Review orphan list and run with DRY_RUN=false if needed"
                }
            }
        }
        failure {
            script {
                echo "\n✗ Pipeline failed"
                echo "  Check the logs above for error details"
            }
        }
        unstable {
            script {
                echo "\n⚠️  Pipeline completed with warnings"
                echo "  Some operations may have failed - check logs for details"
            }
        }
        always {
            script {
                // Cleanup workspace
                echo "\nCleaning up workspace..."
                cleanWs(
                    deleteDirs: true,
                    patterns: [
                        [pattern: 'manifest-cleanup-*', type: 'INCLUDE']
                    ]
                )
            }
        }
    }
}
