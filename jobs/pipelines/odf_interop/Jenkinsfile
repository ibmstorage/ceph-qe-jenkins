// ODF Interop: OCP + ODF Deployment Pipeline on IBM Cloud
// Loaded from the Jenkins shared repo; clones ceph-interop as a build step.
//
// Pipeline Stages:
//   1. Validate Parameters - Check all required parameters and credentials
//   2. Clone ceph-interop - Fetch the deployment automation repository
//   3. Setup Environment - Create Python venv and install dependencies
//   4. Ceph image metadata - cephadm version --verbose JSON (for email)
//   5. Prepare Credentials - Write credentials file from Jenkins secrets
//   6. Update Config - Apply job parameters to deployment.yaml
//   7. Deploy OCP + ODF - Deploy cluster with OpenShift and ODF
//   8. Run IO Workloads - Execute FIO tests on RBD and CephFS
//   9. Teardown - Clean up resources (mandatory)
//
// Post Actions:
//   - Archive cluster artifacts and state files
//   - Send HTML email: status rows + Test case execution rows (Test | Result) in one table
//   - Clean up sensitive credentials

// Import shared library
@Library("ceph-qe-libs@main") _

pipeline {
    agent { label "agents" }

    options {
        timeout(time: 5, unit: 'HOURS')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: "10", daysToKeepStr: "30"))
    }

    environment {
        // Credentials injected from Jenkins CasC
        IBM_CLOUD_API_KEY       = credentials('ibmc-api-key')
        IBM_COS_HMAC_ACCESS_KEY = credentials('ibm-cos-acces-key')
        IBM_COS_HMAC_SECRET_KEY = credentials('ibm-cos-secret-key')
        AWS_ACCESS_KEY_ID       = credentials('aws-systest-access')
        AWS_SECRET_ACCESS_KEY   = credentials('aws-systest-secret-access')

        // Python virtualenv location
        VENV_DIR = "${WORKSPACE}/ceph-interop/.venv"
    }

    stages {

        // ──────────────────────────────────────────────────────────
        // Initialize cluster name early in the pipeline
        // ──────────────────────────────────────────────────────────
        stage("Initialize Cluster Name") {
            steps {
                script {
                    if (params.CLUSTER_NAME?.trim()) {
                        // Use cluster name from parameter if provided
                        env.CLUSTER_NAME = params.CLUSTER_NAME.trim()
                        echo "Using cluster name from parameter: ${env.CLUSTER_NAME}"
                    } else {
                        // Generate unique cluster name
                        def buildNum = env.BUILD_NUMBER
                        def randomHex = sh(
                            script: 'printf "%04x" $((RANDOM % 4096))',
                            returnStdout: true
                        ).trim()
                        env.CLUSTER_NAME = "ocp-ibmc-${buildNum}${randomHex}"
                        echo "Generated cluster name: ${env.CLUSTER_NAME}"
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // Validate parameters before doing any work
        // ──────────────────────────────────────────────────────────
        stage("Validate Parameters") {
            steps {
                script {
                    def errors = []

                    def cephImg = params.CEPH_IMAGE?.trim()
                    def ocpVer = params.OCP_VERSION?.trim()
                    def odfCh = params.ODF_CHANNEL?.trim()
                    def ocpChParam = params.OCP_CHANNEL ?: 'released'

                    if (!cephImg) {
                        errors << "CEPH_IMAGE is required — provide the Ceph version image to test"
                    } else if (ocpVer && odfCh) {
                        env.RESOLVED_OCP_VERSION = ocpVer
                        env.RESOLVED_ODF_CHANNEL = odfCh
                        env.RESOLVED_OCP_CHANNEL = ocpChParam
                        echo "Using explicit OCP_VERSION / ODF_CHANNEL from parameters"
                    } else if (!ocpVer && !odfCh) {
                        try {
                            def inf = null
                            withCredentials([file(credentialsId: 'ocs-pull-secret', variable: 'PULL_SECRET_FILE')]) {
                                inf = resolveOdfInteropParams(
                                    inferAuto: true,
                                    cephImage: cephImg,
                                    rhcsBuildVersion: params.RHCS_BUILD_VERSION?.trim(),
                                    pullSecretFile: env.PULL_SECRET_FILE
                                )
                            }
                            env.RESOLVED_OCP_VERSION = inf.ocpVersion
                            env.RESOLVED_ODF_CHANNEL = inf.odfChannel
                            env.RESOLVED_OCP_CHANNEL = inf.ocpChannel
                            echo "Auto-resolved OCP/ODF (matrix key: ${inf.matrixKey})"
                        } catch (Exception e) {
                            errors << "Could not auto-resolve OCP/ODF: ${e.message}. " +
                                "Set OCP_VERSION and ODF_CHANNEL, or RHCS_BUILD_VERSION (7/8/9.x), or ensure podman can run cephadm on the image (digest refs need pull secret + metadata)."
                        }
                    } else {
                        errors << "Set both OCP_VERSION and ODF_CHANNEL, or leave both empty to infer from CEPH_IMAGE"
                    }

                    // Worker count must be >= 3 for ODF
                    def workerCount = (params.WORKER_COUNT?.trim() ?: '3') as Integer
                    if (workerCount < 3) {
                        errors << "WORKER_COUNT must be >= 3 for ODF (got ${workerCount})"
                    }

                    // Device count must be >= 1
                    def deviceCount = (params.DEVICE_COUNT?.trim() ?: '3') as Integer
                    if (deviceCount < 1) {
                        errors << "DEVICE_COUNT must be >= 1 (got ${deviceCount})"
                    }

                    // Verify credentials are available
                    def credErrors = []
                    if (!env.IBM_CLOUD_API_KEY)       credErrors << "IBM_CLOUD_API_KEY"
                    if (!env.IBM_COS_HMAC_ACCESS_KEY) credErrors << "IBM_COS_HMAC_ACCESS_KEY"
                    if (!env.IBM_COS_HMAC_SECRET_KEY) credErrors << "IBM_COS_HMAC_SECRET_KEY"
                    if (!env.AWS_ACCESS_KEY_ID)       credErrors << "AWS_ACCESS_KEY_ID"
                    if (!env.AWS_SECRET_ACCESS_KEY)   credErrors << "AWS_SECRET_ACCESS_KEY"
                    if (credErrors) {
                        errors << "Missing credentials: ${credErrors.join(', ')}"
                    }

                    if (errors) {
                        echo "╔══════════════════════════════════════════════════╗"
                        echo "║           PARAMETER VALIDATION FAILED            ║"
                        echo "╚══════════════════════════════════════════════════╝"
                        errors.each { echo "  ✗ ${it}" }
                        error("Validation failed:\n" + errors.collect { "  - ${it}" }.join("\n"))
                    }

                    echo "╔══════════════════════════════════════════════════╗"
                    echo "║           PARAMETER VALIDATION PASSED            ║"
                    echo "╚══════════════════════════════════════════════════╝"
                    echo "  OCP_VERSION  : ${env.RESOLVED_OCP_VERSION}"
                    echo "  OCP_CHANNEL  : ${env.RESOLVED_OCP_CHANNEL}"
                    echo "  ODF_CHANNEL  : ${env.RESOLVED_ODF_CHANNEL}"
                    echo "  CEPH_IMAGE   : ${params.CEPH_IMAGE}"
                    echo "  IBM_REGION   : ${params.IBM_REGION}"
                    echo "  VPC_NAME     : ${params.VPC_NAME}"
                    echo "  MASTER_COUNT : ${params.MASTER_COUNT}"
                    echo "  WORKER_COUNT : ${params.WORKER_COUNT}"
                    echo "  DEVICE_SIZE  : ${params.DEVICE_SIZE}G"
                    echo "  DEVICE_COUNT : ${params.DEVICE_COUNT}"
                    echo "  SSH_KEY_NAMES: ${params.SSH_KEY_NAMES}"
                    echo "  PVC_COUNT    : ${params.PVC_COUNT}"

                    // Display cluster name (already set in Initialize stage)
                    if (env.CLUSTER_NAME) {
                        def source = params.CLUSTER_NAME?.trim() ? "(from parameter)" : "(auto-generated)"
                        echo "  CLUSTER_NAME : ${env.CLUSTER_NAME} ${source}"
                    }

                    // Set build description and display name with key parameters
                    def cephImageShort = params.CEPH_IMAGE.split('/')[-1].take(40)

                    if (env.CLUSTER_NAME) {
                        currentBuild.displayName = "#${env.BUILD_NUMBER} - ${env.CLUSTER_NAME}"
                    }

                    // Build simple, clean description with triggering user (first cause is not always UserIdCause)
                    def triggeredBy = 'automated'
                    def causes = currentBuild.getBuildCauses()
                    if (causes) {
                        def uid = causes.findResult { c -> c?.userId ? c.userId.toString().trim() : null }
                        if (uid) {
                            triggeredBy = uid
                        } else {
                            def fromDesc = causes.findResult { c ->
                                def sd = c?.shortDescription?.toString()
                                if (!sd) {
                                    return null
                                }
                                def m = (sd =~ /Started by user (.+)/)
                                m.find() ? m.group(1).trim() : null
                            }
                            if (fromDesc) {
                                triggeredBy = fromDesc
                            }
                        }
                    }
                    def descParts = []
                    descParts << "User: ${triggeredBy}"
                    if (env.CLUSTER_NAME) {
                        descParts << "Cluster: ${env.CLUSTER_NAME}"
                    }
                    descParts << "OCP: ${env.RESOLVED_OCP_VERSION} (${env.RESOLVED_OCP_CHANNEL})"
                    descParts << "Ceph: ${cephImageShort}"

                    currentBuild.description = descParts.join(' | ')

                    // Log build metadata for monitoring
                    echo ""
                    echo "Build Metadata:"
                    echo "  Build Number : ${env.BUILD_NUMBER}"
                    echo "  Build ID     : ${env.BUILD_ID}"
                    echo "  Job Name     : ${env.JOB_NAME}"
                    echo "  Workspace    : ${env.WORKSPACE}"
                    echo "  Started By   : ${triggeredBy}"
                }
            }
        }


        stage("Clone ceph-interop") {
            steps {
                dir("ceph-interop") {
                    echo "Repo: '${params.CEPH_INTEROP_REPO}'"
                    echo "Branch: '${params.CEPH_INTEROP_BRANCH.trim()}'"

                    git(
                        url: params.CEPH_INTEROP_REPO,
                        branch: params.CEPH_INTEROP_BRANCH.trim(),
                        credentialsId: "ceph-qe-sa-pat"
                    )
                }
            }
        }

        stage("Setup Environment") {
            steps {
                dir("ceph-interop") {
                    sh """
                        # Verify Python version (requires >= 3.12)
                        python3.12 --version
                        PYTHON_VERSION=\$(python3.12 --version | awk '{print \$2}' | cut -d. -f1,2)
                        REQUIRED_VERSION="3.12"

                        if [ "\$(printf '%s\\n' "\$REQUIRED_VERSION" "\$PYTHON_VERSION" | sort -V | head -n1)" != "\$REQUIRED_VERSION" ]; then
                            echo "ERROR: Python \$PYTHON_VERSION found, but >= \$REQUIRED_VERSION is required"
                            exit 1
                        fi

                        echo "✓ Python \$PYTHON_VERSION meets requirement (>= \$REQUIRED_VERSION)"
                        
                        # Create virtual environment
                        python3.12 -m venv ${VENV_DIR}
                        
                        # Upgrade pip and install build tools with setuptools version constraint
                        ${VENV_DIR}/bin/pip3.12 install --upgrade pip "setuptools<71" wheel
                        
                        # Install dependencies with --no-build-isolation flag as specified in requirements.txt
                        ${VENV_DIR}/bin/pip3.12 install --no-build-isolation -r requirements.txt
                        
                        echo "✓ Python environment setup complete"
                        echo "✓ Installed packages:"
                        ${VENV_DIR}/bin/pip3.12 list | grep -E "(ibm-|boto3|kubernetes|jinja2|pyyaml|requests|paramiko)"
                    """
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // Ceph container: cephadm version --verbose (JSON for email)
        // ──────────────────────────────────────────────────────────
        stage("Ceph image metadata") {
            steps {
                script {
                    def img = params.CEPH_IMAGE?.trim()
                    if (!img) {
                        echo "Skipping Ceph image metadata: CEPH_IMAGE empty"
                        return
                    }
                    env.CEPH_IMAGE_PODMAN = img
                    withCredentials([file(credentialsId: 'ocs-pull-secret', variable: 'PULL_SECRET_FILE')]) {
                        sh '''
                            set +e
                            rm -f ceph-interop/.cephadm-version.json /tmp/cephadm-version.raw
                            if ! command -v podman >/dev/null 2>&1; then
                                echo "podman not found — skipping cephadm version metadata"
                                exit 0
                            fi
                            podman run --rm --authfile "${PULL_SECRET_FILE}" "${CEPH_IMAGE_PODMAN}" \
                                bash -c "cephadm version --verbose" > /tmp/cephadm-version.raw 2>/tmp/cephadm-version.err
                            ec=$?
                            if [ "$ec" -ne 0 ]; then
                                echo "cephadm version --verbose failed (exit $ec)"
                                cat /tmp/cephadm-version.err 2>/dev/null || true
                                rm -f ceph-interop/.cephadm-version.json
                                exit 0
                            fi
                            # Full stdout is one JSON object (indent=2) with nested keys e.g. bundled_packages.
                            # Do not slice with awk on lone "}" lines — that truncated JSON and broke email Ceph rows.
                            if [ ! -s /tmp/cephadm-version.raw ]; then
                                echo "cephadm version --verbose produced empty stdout"
                                rm -f ceph-interop/.cephadm-version.json
                            elif command -v python3 >/dev/null 2>&1 && ! python3 -c "import json,sys; json.load(open('/tmp/cephadm-version.raw'))" 2>/dev/null; then
                                echo "cephadm stdout is not valid JSON — skipping .cephadm-version.json"
                                rm -f ceph-interop/.cephadm-version.json
                            else
                                cp /tmp/cephadm-version.raw ceph-interop/.cephadm-version.json
                                echo "✓ Wrote ceph-interop/.cephadm-version.json"
                            fi
                            exit 0
                        '''
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // Write credentials file from Jenkins secrets
        // ──────────────────────────────────────────────────────────
        stage("Prepare Credentials") {
            steps {
                dir("ceph-interop") {
                    script {
                        // Create configs directory
                        sh 'mkdir -p configs'

                        // Copy pull-secret.json from Jenkins file credential
                        def secretPath = "configs/pull-secret.json"
                        withCredentials([file(credentialsId: 'ocs-pull-secret', variable: 'PULL_SECRET_FILE')]) {
                            sh """
                                cp "\${PULL_SECRET_FILE}" ${secretPath}
                                chmod 600 ${secretPath}
                                echo "✓ pull-secret.json copied from Jenkins credential"
                            """
                        }

                        // Write credentials.yaml using writeYaml
                        def creds = 'configs/credentials.yaml'
                        def credentialsData = [
                            ibmcloud: [
                                api_key: env.IBM_CLOUD_API_KEY,
                                cos_hmac_access_key_id: env.IBM_COS_HMAC_ACCESS_KEY,
                                cos_hmac_secret_access_key: env.IBM_COS_HMAC_SECRET_KEY
                            ],
                            aws: [
                                access_key_id: env.AWS_ACCESS_KEY_ID,
                                secret_access_key: env.AWS_SECRET_ACCESS_KEY
                            ],
                            pull_secret_path: "${env.WORKSPACE}/ceph-interop/${secretPath}"
                        ]

                        writeYaml(
                            file: creds,
                            data: credentialsData,
                            overwrite: true
                        )

                        // Validate that files were created
                        sh """
                            echo "Validating credential files..."
                            if [ ! -f "${secretPath}" ]; then
                                echo "ERROR: pull-secret.json was not created"
                                exit 1
                            fi
                            if [ ! -f "${creds}" ]; then
                                echo "ERROR: credentials.yaml was not created"
                                exit 1
                            fi
                            echo "✓ pull-secret.json created (size: \$(stat -f%z ${secretPath} 2>/dev/null || stat -c%s ${secretPath}) bytes)"
                            echo "✓ credentials.yaml created (size: \$(stat -f%z ${creds} 2>/dev/null || stat -c%s ${creds}) bytes)"
                            echo "✓ Credentials files validated successfully"
                        """
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // Update deployment.yaml with job parameters
        // ──────────────────────────────────────────────────────────
        stage("Update Config") {
            steps {
                dir("ceph-interop") {
                    script {
                        def masterCount = (params.MASTER_COUNT?.trim() ?: '3') as Integer
                        def workerCount = (params.WORKER_COUNT?.trim() ?: '3') as Integer
                        def deviceSize  = (params.DEVICE_SIZE?.trim() ?: '50') as Integer
                        def deviceCount = (params.DEVICE_COUNT?.trim() ?: '3') as Integer
                        def cephImage   = params.CEPH_IMAGE?.trim() ?: ''
                        def odfChannel  = env.RESOLVED_ODF_CHANNEL?.trim() ?: ''
                        def nightly     = params.ODF_NIGHTLY_INDEX?.trim() ?: ''
                        def sshKeyNames = params.SSH_KEY_NAMES?.trim() ?: 'ceph-qe-sa,ceph-qe-sa-svc'

                        // Read existing deployment configuration
                        def config = readYaml(file: 'configs/deployment.yaml')

                        // ── Cluster / OCP Configuration ──────────────────────
                        // Set OpenShift version and release channel (released/nightly)
                        config.cluster.ocp_version = env.RESOLVED_OCP_VERSION
                        config.cluster.ocp_channel = env.RESOLVED_OCP_CHANNEL

                        // ── IBM Cloud Infrastructure ─────────────────────────
                        // Configure IBM Cloud region, COS region, and VPC
                        config.ibmcloud.region = params.IBM_REGION
                        config.ibmcloud.cos_region = 'au-syd'  // Fixed COS region for object storage
                        config.ibmcloud.vpc_name = params.VPC_NAME

                        // ── Cluster Node Configuration ───────────────────────
                        // Set master (control plane) and worker node counts
                        config.ibmcloud.master.count = masterCount
                        config.ibmcloud.worker.count = workerCount

                        // ── Storage Configuration (OSD Disks) ────────────────
                        // Configure data volumes attached to each worker node for Ceph OSDs
                        config.ibmcloud.worker.data_volumes.capacity_gb = deviceSize
                        config.ibmcloud.worker.data_volumes.count = deviceCount

                        // ── ODF Operator Configuration ───────────────────────
                        // Set ODF operator channel (e.g., stable-4.20) or use default
                        if (odfChannel) {
                            config.odf.channel = odfChannel
                        } else {
                            config.odf.channel = ''  // Use default channel
                        }

                        // Set ODF nightly catalog index if testing pre-release builds
                        if (nightly) {
                            config.odf.nightly_index_image = nightly
                        }

                        // Set Ceph container image to test (required parameter)
                        if (cephImage) {
                            config.odf.ceph_image = cephImage
                        }

                        // ── SSH Access Configuration ─────────────────────────
                        // Parse comma-separated SSH key names for VSI access
                        if (sshKeyNames) {
                            config.ibmcloud.ssh_key_names = sshKeyNames.split(',').collect { it.trim() }.findAll { it }
                        }

                        // ── ODF Storage Cluster Sizing ───────────────────────
                        // Device set count matches worker count (one device set per worker)
                        // OSD size matches the data volume size configured above
                        config.odf.device_set_count = workerCount
                        config.odf.osd_size = "${deviceSize}Gi"

                        // Write updated configuration back to file using writeYaml
                        def configFile = 'configs/deployment.yaml'
                        writeYaml(
                            file: configFile,
                            data: config,
                            overwrite: true
                        )

                        // Display updated configuration
                        echo 'Updated deployment.yaml:'
                        echo "  OCP version   : ${config.cluster.ocp_version}"
                        echo "  OCP channel   : ${config.cluster.ocp_channel}"
                        echo "  ODF channel   : ${config.odf.channel ?: '(default)'}"
                        echo "  Ceph image    : ${config.odf.ceph_image ?: '(none)'}"
                        echo "  IBM region    : ${config.ibmcloud.region}"
                        echo "  VPC           : ${config.ibmcloud.vpc_name}"
                        echo "  Masters       : ${config.ibmcloud.master.count}"
                        echo "  Workers       : ${config.ibmcloud.worker.count}"
                        echo "  Device size   : ${config.ibmcloud.worker.data_volumes.capacity_gb} GB"
                        echo "  Device count  : ${config.ibmcloud.worker.data_volumes.count} per worker"
                        echo "  SSH keys      : ${config.ibmcloud.ssh_key_names}"
                        echo "  OSD size      : ${config.odf.osd_size}"
                        if (nightly) {
                            echo "  ODF nightly   : ${nightly}"
                        }
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // Deploy OCP + ODF
        // ──────────────────────────────────────────────────────────
        stage("Deploy OCP + ODF") {
            steps {
                dir("ceph-interop") {
                    script {
                        echo "Deploying cluster: ${env.CLUSTER_NAME}"
                        sh """
                            ${VENV_DIR}/bin/python3.12 run.py deploy \
                                --cluster-name '${env.CLUSTER_NAME}' \
                                --verbose
                        """
                        echo "✓ Cluster deployed successfully: ${env.CLUSTER_NAME}"
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // Run IO Workloads
        // ──────────────────────────────────────────────────────────
        stage("Run IO Workloads") {
            steps {
                dir("ceph-interop") {
                    script {
                        def pvcCount = params.PVC_COUNT?.trim() ?: "1"
                        echo "Running IO workloads on cluster: ${env.CLUSTER_NAME} (pvc-count: ${pvcCount})"
                        sh """
                            ${VENV_DIR}/bin/python3.12 run.py workload \
                                --cluster-name '${env.CLUSTER_NAME}' \
                                --pvc-count ${pvcCount} \
                                --verbose
                        """
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // Teardown (mandatory)
        // ──────────────────────────────────────────────────────────
        stage("Teardown") {
            steps {
                dir("ceph-interop") {
                    script {
                        echo "Tearing down cluster: ${env.CLUSTER_NAME}"
                        sh """
                            ${VENV_DIR}/bin/python3.12 run.py teardown \
                                --cluster-name '${env.CLUSTER_NAME}' \
                                --verbose
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                // Use cluster name from environment
                def clusterName = env.CLUSTER_NAME ?: ""
                def hasCluster = clusterName ? true : false

                // ── Archive cluster artifacts (best-effort) ───────────
                try {
                    dir("ceph-interop") {
                        if (hasCluster) {
                            // Archive the specific state file for this cluster (legacy location)
                            archiveArtifacts artifacts: "configs/${clusterName}-state.json", allowEmptyArchive: true

                            sh """
                                if [ -d "work/clusters/${clusterName}" ]; then
                                    tar czf "cluster-artifacts-${clusterName}.tar.gz" \
                                        --exclude='bin' \
                                        -C work/clusters \
                                        "${clusterName}" 2>/dev/null || true
                                    echo "Created cluster-artifacts-${clusterName}.tar.gz"
                                else
                                    echo "Cluster directory work/clusters/${clusterName} not found — skipping archive"
                                fi
                            """
                            archiveArtifacts artifacts: "cluster-artifacts-${clusterName}.tar.gz", allowEmptyArchive: true
                            archiveArtifacts artifacts: "work/clusters/${clusterName}/openshift/auth/*", allowEmptyArchive: true
                            archiveArtifacts artifacts: "work/clusters/${clusterName}/workload-report-*.txt", allowEmptyArchive: true
                        } else {
                            echo "No cluster name available — skipping cluster artifact archival"
                        }
                    }
                } catch (Exception e) {
                    echo "Artifact archival failed (non-fatal): ${e.message}"
                }

                // ── Build email (always sent, even on abort/failure) ──
                try {
                    def status = currentBuild.currentResult ?: 'UNKNOWN'
                    def statusMap = [
                        'SUCCESS':  [ mark: '[✓]', captionBg: '#4CAF50', labelBg: '#C6EFCE', valueBg: '#E8F5E9' ],
                        'FAILURE':  [ mark: '[✗]', captionBg: '#E53935', labelBg: '#F4CCCC', valueBg: '#FDE8E8' ],
                        'ABORTED':  [ mark: '[—]', captionBg: '#FF9800', labelBg: '#FFF3E0', valueBg: '#FFF8E1' ],
                        'UNSTABLE': [ mark: '[!]', captionBg: '#FFC107', labelBg: '#FFF9C4', valueBg: '#FFFDE7' ],
                    ]
                    def colors = statusMap[status] ?: statusMap['FAILURE']

                    // Email table: fixed columns, soft borders (readable in Outlook/Gmail)
                    def lab = "background-color: ${colors.labelBg}; border: 1px solid #d0d0d0; padding: 9px 12px; vertical-align: top; width: 34%; font-size: 13px;"
                    def val = "background-color: ${colors.valueBg}; border: 1px solid #d0d0d0; padding: 9px 12px; vertical-align: top; font-size: 13px; line-height: 1.45;"
                    def cephValStyle = "${val} word-break: break-all; font-size: 12px; font-family: Consolas, Monaco, 'Courier New', monospace; line-height: 1.35;"

                    def ocpVer = env.RESOLVED_OCP_VERSION ?: 'N/A'
                    def odfCh  = env.RESOLVED_ODF_CHANNEL ?: 'default'
                    def subject = "CEPH-ODF INTEROP TESTING — OCP ${ocpVer} / ODF ${odfCh} — ${status}"

                    // Build version links (safe for null params)
                    def ocpVersion = env.RESOLVED_OCP_VERSION ?: ''
                    def ocpChannel = env.RESOLVED_OCP_CHANNEL ?: 'released'
                    def ocpMirrorBase = (ocpChannel == 'nightly')
                        ? 'https://mirror.openshift.com/pub/openshift-v4/clients/ocp-dev-preview'
                        : 'https://mirror.openshift.com/pub/openshift-v4/clients/ocp'
                    def ocpCell = ocpVersion
                        ? "<a href=\"${ocpMirrorBase}/${ocpVersion}/\">${ocpVersion}</a> (${ocpChannel})"
                        : 'N/A'

                    def odfChannel = env.RESOLVED_ODF_CHANNEL ?: ''
                    def odfCell = 'default'
                    if (odfChannel) {
                        def odfVersion = odfChannel.replaceAll(/^.*?(\d+\.\d+).*/, '$1')
                        def odfLink = "https://access.redhat.com/documentation/en-us/red_hat_openshift_data_foundation/${odfVersion}"
                        odfCell = "<a href=\"${odfLink}\">${odfChannel}</a>"
                    }

                    // Ceph image provided as parameter
                    def cephImage = params.CEPH_IMAGE ?: ''
                    def cephImageRow = ""
                    if (cephImage) {
                        cephImageRow = """
                    <tr>
                        <td style="${lab}"><b>Ceph Image</b></td>
                        <td style="${cephValStyle}">${cephImage}</td>
                    </tr>"""
                    }

                    def htmlEsc = { s ->
                        if (s == null) { return '' }
                        return s.toString().replace('&', '&amp;')
                            .replace('<', '&lt;')
                            .replace('>', '&gt;')
                            .replace('"', '&quot;')
                    }

                    // Ceph version / commit / release from cephadm JSON (Ceph image metadata stage)
                    def cephNice = 'N/A'
                    def cephCommit = 'N/A'
                    def cephRelName = 'N/A'
                    try {
                        def metaPath = 'ceph-interop/.cephadm-version.json'
                        if (fileExists(metaPath)) {
                            def meta = readJSON file: metaPath
                            echo "Email: read ${metaPath} successfully (readJSON)"
                            // cephadm command_version --verbose (json.dump): ceph_git_nice_ver, ceph_git_ver, ceph_release_name
                            if (meta?.ceph_git_nice_ver) { cephNice = meta.ceph_git_nice_ver.toString() }
                            if (meta?.ceph_git_ver) { cephCommit = meta.ceph_git_ver.toString() }
                            if (meta?.ceph_release_name) { cephRelName = meta.ceph_release_name.toString() }
                            def n = [cephNice, cephCommit, cephRelName].count { it != 'N/A' }
                            if (n > 0) {
                                echo "Email: populated ${n}/3 Ceph email rows from JSON (version, commit, release name)"
                            } else {
                                echo "Email: JSON loaded but ceph_git_nice_ver / ceph_git_ver / ceph_release_name were empty or missing"
                            }
                        } else {
                            echo "Email: ${metaPath} not found (Ceph image metadata stage may have been skipped or failed)"
                        }
                    } catch (Exception e) {
                        echo "Email: could not parse .cephadm-version.json — ${e.message}"
                    }
                    def cephMetaRows = """
                    <tr>
                        <td style="${lab}"><b>Ceph version</b></td>
                        <td style="${cephValStyle}">${htmlEsc(cephNice)}</td>
                    </tr>
                    <tr>
                        <td style="${lab}"><b>Ceph commit</b></td>
                        <td style="${cephValStyle}">${htmlEsc(cephCommit)}</td>
                    </tr>
                    <tr>
                        <td style="${lab}"><b>Ceph release name</b></td>
                        <td style="${cephValStyle}">${htmlEsc(cephRelName)}</td>
                    </tr>"""

                    // Test case rows (same table as status): section header + Test | Result (titles only)
                    def workloadOk = (status == 'SUCCESS')
                    def deployResult = status == 'SUCCESS' ? 'Pass' : (status == 'ABORTED' ? 'Not run' : 'Fail')
                    def tcBar = (status == 'SUCCESS') ? '#43A047' : ((status == 'ABORTED') ? '#FB8C00' : '#E53935')
                    def tcHdrBg = (status == 'SUCCESS') ? '#E8F5E9' : ((status == 'ABORTED') ? '#FFF8E1' : '#FFEBEE')
                    def tcHdrFg = (status == 'SUCCESS') ? '#1B5E20' : ((status == 'ABORTED') ? '#E65100' : '#B71C1C')
                    def tcSectionHeader = """
                        <tr>
                            <td colspan="2" style="background-color: ${tcHdrBg}; color: ${tcHdrFg}; border: 1px solid #d0d0d0; border-top: 3px solid ${tcBar}; padding: 10px 14px; font-size: 108%; font-weight: bold;">
                                Test case execution
                            </td>
                        </tr>"""
                    def tcRow2 = { String title, String resultStr ->
                        """                        <tr>
                            <td style="${lab} vertical-align: middle;"><b>${htmlEsc(title)}</b></td>
                            <td style="${val} font-weight: bold; vertical-align: middle; text-align: right; white-space: nowrap;">${htmlEsc(resultStr)}</td>
                        </tr>"""
                    }

                    def testCaseRowsHtml = ""
                    if (hasCluster) {
                        try {
                            def reportPath = sh(
                                script: "ls ceph-interop/work/clusters/${clusterName}/workload-report-*.txt 2>/dev/null | head -1",
                                returnStdout: true
                            ).trim()
                            if (reportPath && fileExists(reportPath)) {
                                def text = readFile(reportPath)
                                def allowedScNames = ['ocs-storagecluster-ceph-rbd', 'ocs-storagecluster-cephfs'] as Set
                                def scNames = new LinkedHashSet()

                                def scm = text =~ /(?i)\b(ocs-storagecluster-ceph-(?:rbd|cephfs))\b/
                                while (scm.find()) {
                                    scNames << scm.group(1).toLowerCase()
                                }
                                text.split('\n').each { line ->
                                    def t = line.trim()
                                    def m = (t =~ /(?i)storageclass[^:]*:\s*(\S+)/)
                                    if (m.find()) {
                                        def scVal = m.group(1).toLowerCase()
                                        if (allowedScNames.contains(scVal)) {
                                            scNames << scVal
                                        }
                                    }
                                    m = (t =~ /(?i)storageclassname[^:]*:\s*(\S+)/)
                                    if (m.find()) {
                                        def scVal = m.group(1).toLowerCase()
                                        if (allowedScNames.contains(scVal)) {
                                            scNames << scVal
                                        }
                                    }
                                }

                                def bwLines = new LinkedHashSet()
                                def iopsLines = new LinkedHashSet()
                                def latLines = new LinkedHashSet()
                                text.split('\n').each { line ->
                                    def t = line.trim()
                                    if (!t) { return }
                                    def u = t.toLowerCase()
                                    if (u.contains('kib/s') || u.contains('mib/s') || u.contains('gib/s') ||
                                            (u.contains('bw') && (u.contains('=') || u.contains('('))) ||
                                            u.contains('throughput') || (u.contains('read:') && u.contains('/s')) ||
                                            (u.contains('write:') && u.contains('/s'))) {
                                        bwLines << t
                                    }
                                    if (u.contains('iops') || u =~ /(?i)\b\d+\s*iops\b/) {
                                        iopsLines << t
                                    }
                                    if (u.contains('lat') && (u.contains('usec') || u.contains('msec') || u.contains('clat') ||
                                            u.contains('slat') || u.contains('avg=') || u.contains(' min=') || u.contains(' max='))) {
                                        latLines << t
                                    }
                                }
                                def hasIoMetrics = !bwLines.isEmpty() || !iopsLines.isEmpty() || !latLines.isEmpty()

                                def bodyRows = new StringBuilder()
                                bodyRows.append(tcSectionHeader)
                                bodyRows.append(tcRow2('OCP + ODF deployment', deployResult))

                                if (scNames.isEmpty()) {
                                    def r = workloadOk ? 'Partial' : 'Fail'
                                    bodyRows.append(tcRow2('Storage class validation', r))
                                } else {
                                    scNames.each { sc ->
                                        def refs = 0
                                        text.split('\n').each { ln ->
                                            if (ln.toLowerCase().contains(sc)) {
                                                refs++
                                            }
                                        }
                                        def r = (workloadOk && refs > 0) ? 'Pass' : (workloadOk ? 'Partial' : 'Fail')
                                        bodyRows.append(tcRow2("Storage class validation — ${sc}", r))
                                    }
                                }

                                def ioRes = (workloadOk && hasIoMetrics) ? 'Pass' : (workloadOk ? 'Partial' : 'Fail')
                                bodyRows.append(tcRow2('IO metrics (FIO / workload)', ioRes))

                                testCaseRowsHtml = bodyRows.toString()
                            }
                        } catch (Exception ignored) { /* no report */ }
                    }
                    if (!testCaseRowsHtml) {
                        testCaseRowsHtml = """
                        ${tcSectionHeader}
                        ${tcRow2('OCP + ODF deployment', deployResult)}
                        ${tcRow2('Storage class validation', 'Not run')}
                        ${tcRow2('IO metrics (FIO / workload)', 'Not run')}"""
                    }

                    // Infrastructure row (always present)
                    def infrastructureRow = """
                    <tr>
                        <td style="${lab}"><b>Infrastructure</b></td>
                        <td style="${val}">IBM Cloud</td>
                    </tr>"""

                    def duration = 'N/A'
                    try { duration = currentBuild.durationString.replace(' and counting', '') } catch (Exception ignored) {}

                    def body = """
                    <html>
                    <body style="margin: 0; padding: 0;">
                    <table style="font-family: 'Segoe UI', Arial, Helvetica, sans-serif; border-collapse: collapse; width: 100%; max-width: 720px; table-layout: fixed; background-color: ${colors.valueBg};">
                        <caption style="background-color: ${colors.captionBg}; color: #FFFFFF; border: 1px solid #c0c0c0; height: 44px; font-size: 124%; font-weight: bold; padding: 10px 12px;">
                            ${colors.mark} CEPH-ODF INTEROP TESTING — ${status}
                        </caption>
                        <colgroup><col style="width: 34%;" /><col style="width: 66%;" /></colgroup>
                        <tr>
                            <td style="${lab}"><b>OCP Version</b></td>
                            <td style="${val}">${ocpCell}</td>
                        </tr>
                        <tr>
                            <td style="${lab}"><b>ODF Channel</b></td>
                            <td style="${val}">${odfCell}</td>
                        </tr>
${cephImageRow}
${cephMetaRows}
${infrastructureRow}
                        <tr>
                            <td style="${lab}"><b>IBM Region</b></td>
                            <td style="${val}">${params.IBM_REGION ?: 'N/A'}</td>
                        </tr>
                        <tr>
                            <td style="${lab}"><b>VPC</b></td>
                            <td style="${val}">${params.VPC_NAME ?: 'N/A'}</td>
                        </tr>
                        <tr>
                            <td style="${lab}"><b>Build</b></td>
                            <td style="${val}"><a href="${env.BUILD_URL}">${env.JOB_NAME} #${env.BUILD_NUMBER}</a></td>
                        </tr>
                        <tr>
                            <td style="${lab}"><b>Duration</b></td>
                            <td style="${val}">${duration}</td>
                        </tr>
${testCaseRowsHtml}
                    </table>
                    </body>
                    </html>
                    """.stripIndent()

                    def attachPattern = hasCluster
                        ? "ceph-interop/cluster-artifacts-${clusterName}.tar.gz, ceph-interop/configs/${clusterName}-state.json"
                        : ''

                    emailext(
                        mimeType: 'text/html',
                        subject: subject,
                        body: body,
                        to: params.EMAIL_ADDRESS ?: '',
                        attachmentsPattern: attachPattern
                    )
                } catch (Exception e) {
                    echo "Email notification failed: ${e.message}"
                } finally {
                    // After email (needs .cephadm-version.json for Ceph rows); always remove secrets
                    dir("ceph-interop") {
                        sh '''
                            echo "Cleaning up credential files..."
                            rm -f configs/credentials.yaml configs/pull-secret.json 2>/dev/null || true
                            echo "✓ Credential files cleaned up"
                        '''
                    }
                }
            }
        }
    }
}
