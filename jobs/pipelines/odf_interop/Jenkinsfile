// ODF Interop: OCP + ODF Deployment Pipeline on IBM Cloud
// Loaded from the Jenkins shared repo; clones ceph-interop as a build step.
//
// Pipeline Stages:
//   1. Validate Parameters - Check all required parameters and credentials
//   2. Clone ceph-interop - Fetch the deployment automation repository
//   3. Setup Environment - Create Python venv and install dependencies
//   4. Ceph image metadata - cephadm version --verbose JSON (for email)
//   5. Prepare Credentials - Write credentials file from Jenkins secrets
//   6. Update Config - Apply job parameters to deployment.yaml
//   7. Deploy OCP + ODF - Deploy cluster with OpenShift and ODF
//   8. Run IO Workloads - Execute FIO tests on RBD and CephFS
//   9. Clone ocs-ci - Fetch the ocs-ci test framework
//  10. Setup ocs-ci Environment - Create Python 3.11 venv and install ocs-ci
//  11. Prepare ocs-ci Config - Write runtime auth config, copy pull-secret
//  12. Run ocs-ci Tests - Execute acceptance (or custom) tests via run-ci
//
// Post Actions:
//   - Teardown cluster (mandatory, runs even on failure/abort)
//   - Archive cluster artifacts, state files, and ocs-ci test logs
//   - Send HTML email: status rows + Test case execution rows (Test | Result) in one table
//   - Clean up sensitive credentials

// Import shared library
@Library("ceph-qe-libs@main") _

pipeline {
    agent { label "agents-interop" }

    options {
        timeout(time: 8, unit: 'HOURS')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: "10", daysToKeepStr: "30"))
    }

    environment {
        // Credentials injected from Jenkins CasC
        IBM_CLOUD_API_KEY       = credentials('ibmc-api-key')
        IBM_CLOUD_ACCOUNT_ID    = credentials('ibmc-account-id')
        IBM_COS_HMAC_ACCESS_KEY = credentials('ibm-cos-acces-key')
        IBM_COS_HMAC_SECRET_KEY = credentials('ibm-cos-secret-key')
        AWS_ACCESS_KEY_ID       = credentials('aws-systest-access')
        AWS_SECRET_ACCESS_KEY   = credentials('aws-systest-secret-access')

        // Python virtualenv locations (separate: ceph-interop uses 3.12, ocs-ci needs <3.12)
        VENV_DIR       = "${WORKSPACE}/ceph-interop/.venv"
        OCSCI_VENV_DIR = "${WORKSPACE}/ocs-ci/.venv"
    }

    stages {

        // ──────────────────────────────────────────────────────────
        // Initialize cluster name early in the pipeline
        // ──────────────────────────────────────────────────────────
        stage("Initialize Cluster Name") {
            steps {
                script {
                    if (params.CLUSTER_NAME?.trim()) {
                        env.CLUSTER_NAME = params.CLUSTER_NAME.trim()
                        echo "Using cluster name from parameter: ${env.CLUSTER_NAME}"
                    } else {
                        def buildNum = env.BUILD_NUMBER
                        def randomHex = sh(
                            script: 'printf "%04x" $((RANDOM % 4096))',
                            returnStdout: true
                        ).trim()
                        env.CLUSTER_NAME = "ocp-ibmc-${buildNum}${randomHex}"
                        echo "Generated cluster name: ${env.CLUSTER_NAME}"
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // Validate parameters before doing any work
        // ──────────────────────────────────────────────────────────
        stage("Validate Parameters") {
            steps {
                script {
                    def errors = []

                    def cephImg = params.CEPH_IMAGE?.trim()
                    def ocpVer = params.OCP_VERSION?.trim()
                    def odfCh = params.ODF_CHANNEL?.trim()
                    def ocpChParam = params.OCP_CHANNEL ?: 'released'

                    if (!cephImg) {
                        errors << "CEPH_IMAGE is required \u2014 provide the Ceph version image to test"
                    } else if (ocpVer && odfCh) {
                        env.RESOLVED_OCP_VERSION = ocpVer
                        env.RESOLVED_ODF_CHANNEL = odfCh
                        env.RESOLVED_OCP_CHANNEL = ocpChParam
                        env.RESOLVED_OCS_VERSION = odfCh.replaceAll(/^.*?(\d+\.\d+).*/, '$1')
                        echo "Using explicit OCP_VERSION / ODF_CHANNEL from parameters"
                    } else if (!ocpVer && !odfCh) {
                        try {
                            def inf = null
                            withCredentials([file(credentialsId: 'ocs-pull-secret', variable: 'PULL_SECRET_FILE')]) {
                                inf = resolveOdfInteropParams(
                                    inferAuto: true,
                                    cephImage: cephImg,
                                    rhcsBuildVersion: params.RHCS_BUILD_VERSION?.trim(),
                                    pullSecretFile: env.PULL_SECRET_FILE
                                )
                            }
                            if (!inf) {
                                def img = cephImg.split('/')[-1].take(40)
                                currentBuild.description = "Skipped: unsupported Ceph stream (only squid / tentacle) | Ceph: ${img}"
                                env.PIPELINE_SKIP = 'true'
                                error("Unsupported Ceph stream -- exiting gracefully as NOT_BUILT")
                            }
                            env.RESOLVED_OCP_VERSION = inf.ocpVersion
                            env.RESOLVED_ODF_CHANNEL = inf.odfChannel
                            env.RESOLVED_OCP_CHANNEL = inf.ocpChannel
                            env.RESOLVED_OCS_VERSION = inf.ocsVersion
                            echo "Auto-resolved OCP/ODF (matrix key: ${inf.matrixKey})"
                        } catch (Exception e) {
                            errors << "Could not auto-resolve OCP/ODF: ${e.message}. " +
                                "Set OCP_VERSION and ODF_CHANNEL, or RHCS_BUILD_VERSION (8/9.x), or ensure podman can run cephadm on the image (digest refs need pull secret + metadata)."
                        }
                    } else {
                        errors << "Set both OCP_VERSION and ODF_CHANNEL, or leave both empty to infer from CEPH_IMAGE"
                    }

                    def workerCount = (params.WORKER_COUNT?.trim() ?: '3') as Integer
                    if (workerCount < 3) {
                        errors << "WORKER_COUNT must be >= 3 for ODF (got ${workerCount})"
                    }

                    def deviceCount = (params.DEVICE_COUNT?.trim() ?: '3') as Integer
                    if (deviceCount < 1) {
                        errors << "DEVICE_COUNT must be >= 1 (got ${deviceCount})"
                    }

                    def credErrors = []
                    if (!env.IBM_CLOUD_API_KEY)       credErrors << "IBM_CLOUD_API_KEY"
                    if (!env.IBM_COS_HMAC_ACCESS_KEY) credErrors << "IBM_COS_HMAC_ACCESS_KEY"
                    if (!env.IBM_COS_HMAC_SECRET_KEY) credErrors << "IBM_COS_HMAC_SECRET_KEY"
                    if (!env.AWS_ACCESS_KEY_ID)       credErrors << "AWS_ACCESS_KEY_ID"
                    if (!env.AWS_SECRET_ACCESS_KEY)   credErrors << "AWS_SECRET_ACCESS_KEY"
                    if (credErrors) {
                        errors << "Missing credentials: ${credErrors.join(', ')}"
                    }

                    if (errors) {
                        echo "Parameter validation failed:"
                        errors.each { echo "  - ${it}" }
                        error("Validation failed:\n" + errors.collect { "  - ${it}" }.join("\n"))
                    }

                    echo "Parameter validation passed. Resolved configuration:"
                    echo "  OCP_VERSION  : ${env.RESOLVED_OCP_VERSION}"
                    echo "  OCP_CHANNEL  : ${env.RESOLVED_OCP_CHANNEL}"
                    echo "  ODF_CHANNEL  : ${env.RESOLVED_ODF_CHANNEL}"
                    echo "  OCS_VERSION  : ${env.RESOLVED_OCS_VERSION}"
                    echo "  CEPH_IMAGE   : ${params.CEPH_IMAGE}"
                    echo "  IBM_REGION   : ${params.IBM_REGION}"
                    echo "  VPC_NAME     : ${params.VPC_NAME}"
                    echo "  MASTER_COUNT : ${params.MASTER_COUNT}"
                    echo "  WORKER_COUNT : ${params.WORKER_COUNT}"
                    echo "  DEVICE_SIZE  : ${params.DEVICE_SIZE}G"
                    echo "  DEVICE_COUNT : ${params.DEVICE_COUNT}"
                    echo "  SSH_KEY_NAMES: ${params.SSH_KEY_NAMES}"
                    echo "  PVC_COUNT    : ${params.PVC_COUNT}"
                    echo "  OCS_CI_REPO   : ${params.OCS_CI_REPO}"
                    echo "  OCS_CI_BRANCH : ${params.OCS_CI_BRANCH?.trim() ?: 'master'}"
                    echo "  OCS_VERSION   : ${params.OCS_VERSION?.trim() ?: '(inferred from ODF channel for run-ci --ocs-version)'}"
                    def ocsTestArg = (params.OCS_CI_TESTS ?: '-m acceptance').toString()
                    echo "  OCS_CI_TESTS  : ${ocsTestArg.length() > 70 ? ocsTestArg.substring(0, 67) + '...' : ocsTestArg}"

                    if (env.CLUSTER_NAME) {
                        def source = params.CLUSTER_NAME?.trim() ? "(from parameter)" : "(auto-generated)"
                        echo "  CLUSTER_NAME : ${env.CLUSTER_NAME} ${source}"
                    }

                    def cephImageShort = params.CEPH_IMAGE.split('/')[-1].take(40)

                    if (env.CLUSTER_NAME) {
                        currentBuild.displayName = "#${env.BUILD_NUMBER} - ${env.CLUSTER_NAME}"
                    }

                    def triggeredBy = 'automated'
                    def causes = currentBuild.getBuildCauses()
                    if (causes) {
                        def uid = causes.findResult { c -> c?.userId ? c.userId.toString().trim() : null }
                        if (uid) {
                            triggeredBy = uid
                        } else {
                            def fromDesc = causes.findResult { c ->
                                def sd = c?.shortDescription?.toString()
                                if (!sd) {
                                    return null
                                }
                                def m = (sd =~ /Started by user (.+)/)
                                m.find() ? m.group(1).trim() : null
                            }
                            if (fromDesc) {
                                triggeredBy = fromDesc
                            }
                        }
                    }
                    def descParts = []
                    descParts << "User: ${triggeredBy}"
                    if (env.CLUSTER_NAME) {
                        descParts << "Cluster: ${env.CLUSTER_NAME}"
                    }
                    descParts << "OCP: ${env.RESOLVED_OCP_VERSION} (${env.RESOLVED_OCP_CHANNEL})"
                    descParts << "Ceph: ${cephImageShort}"

                    currentBuild.description = descParts.join(' | ')

                    echo ""
                    echo "Build Metadata:"
                    echo "  Build Number : ${env.BUILD_NUMBER}"
                    echo "  Build ID     : ${env.BUILD_ID}"
                    echo "  Job Name     : ${env.JOB_NAME}"
                    echo "  Workspace    : ${env.WORKSPACE}"
                    echo "  Started By   : ${triggeredBy}"
                }
            }
        }

        stage("Clone ceph-interop") {
            steps {
                dir("ceph-interop") {
                    echo "Repo: '${params.CEPH_INTEROP_REPO}'"
                    echo "Branch: '${params.CEPH_INTEROP_BRANCH.trim()}'"

                    git(
                        url: params.CEPH_INTEROP_REPO,
                        branch: params.CEPH_INTEROP_BRANCH.trim(),
                        credentialsId: "ceph-qe-sa-pat"
                    )
                }
            }
        }

        stage("Setup Environment") {
            steps {
                dir("ceph-interop") {
                    sh """
                        # Verify Python version (requires >= 3.12)
                        python3.12 --version
                        PYTHON_VERSION=\$(python3.12 --version | awk '{print \$2}' | cut -d. -f1,2)
                        REQUIRED_VERSION="3.12"

                        if [ "\$(printf '%s\\n' "\$REQUIRED_VERSION" "\$PYTHON_VERSION" | sort -V | head -n1)" != "\$REQUIRED_VERSION" ]; then
                            echo "ERROR: Python \$PYTHON_VERSION found, but >= \$REQUIRED_VERSION is required"
                            exit 1
                        fi

                        echo "Python \$PYTHON_VERSION meets requirement (>= \$REQUIRED_VERSION)"
                        
                        python3.12 -m venv ${VENV_DIR}
                        ${VENV_DIR}/bin/pip3.12 install --upgrade pip "setuptools<71" wheel
                        ${VENV_DIR}/bin/pip3.12 install --no-build-isolation -r requirements.txt
                        
                        echo "Python environment setup complete"
                        ${VENV_DIR}/bin/pip3.12 list | grep -E "(ibm-|boto3|kubernetes|jinja2|pyyaml|requests|paramiko)"
                    """
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // Ceph container: cephadm version --verbose (JSON for email)
        // ──────────────────────────────────────────────────────────
        stage("Ceph image metadata") {
            steps {
                script {
                    def img = params.CEPH_IMAGE?.trim()
                    if (!img) {
                        echo "Skipping Ceph image metadata: CEPH_IMAGE empty"
                        return
                    }
                    withCredentials([file(credentialsId: 'ocs-pull-secret', variable: 'PULL_SECRET_FILE')]) {
                        fetchCephImageMetadata(
                            image: img,
                            pullSecretFile: env.PULL_SECRET_FILE,
                        )
                    }
                    def metaPath = "${env.WORKSPACE}/.cephadm-resolve-${env.BUILD_NUMBER ?: '0'}.json"
                    if (fileExists(metaPath)) {
                        def meta = readJSON file: metaPath
                        if (meta?.ceph_git_nice_ver) {
                            def desc = currentBuild.description ?: ''
                            currentBuild.description = desc.replaceAll(/Ceph: .*/, "Ceph: ${meta.ceph_git_nice_ver}")
                        }
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // Write credentials file from Jenkins secrets
        // ──────────────────────────────────────────────────────────
        stage("Prepare Credentials") {
            steps {
                dir("ceph-interop") {
                    script {
                        sh 'mkdir -p configs'

                        def secretPath = "configs/pull-secret.json"
                        withCredentials([file(credentialsId: 'ocs-pull-secret', variable: 'PULL_SECRET_FILE')]) {
                            sh """
                                cp "\${PULL_SECRET_FILE}" ${secretPath}
                                chmod 600 ${secretPath}
                                echo "pull-secret.json copied from Jenkins credential"
                            """
                        }

                        def creds = 'configs/credentials.yaml'
                        def credentialsData = [
                            ibmcloud: [
                                api_key: env.IBM_CLOUD_API_KEY,
                                cos_hmac_access_key_id: env.IBM_COS_HMAC_ACCESS_KEY,
                                cos_hmac_secret_access_key: env.IBM_COS_HMAC_SECRET_KEY
                            ],
                            aws: [
                                access_key_id: env.AWS_ACCESS_KEY_ID,
                                secret_access_key: env.AWS_SECRET_ACCESS_KEY
                            ],
                            pull_secret_path: "${env.WORKSPACE}/ceph-interop/${secretPath}"
                        ]

                        writeYaml(
                            file: creds,
                            data: credentialsData,
                            overwrite: true
                        )

                        sh """
                            echo "Validating credential files..."
                            if [ ! -f "${secretPath}" ]; then
                                echo "ERROR: pull-secret.json was not created"
                                exit 1
                            fi
                            if [ ! -f "${creds}" ]; then
                                echo "ERROR: credentials.yaml was not created"
                                exit 1
                            fi
                            echo "pull-secret.json created (size: \$(stat -f%z ${secretPath} 2>/dev/null || stat -c%s ${secretPath}) bytes)"
                            echo "credentials.yaml created (size: \$(stat -f%z ${creds} 2>/dev/null || stat -c%s ${creds}) bytes)"
                            echo "Credentials files validated successfully"
                        """
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // Update deployment.yaml with job parameters
        // ──────────────────────────────────────────────────────────
        stage("Update Config") {
            steps {
                dir("ceph-interop") {
                    script {
                        def masterCount = (params.MASTER_COUNT?.trim() ?: '3') as Integer
                        def workerCount = (params.WORKER_COUNT?.trim() ?: '3') as Integer
                        def deviceSize  = (params.DEVICE_SIZE?.trim() ?: '50') as Integer
                        def deviceCount = (params.DEVICE_COUNT?.trim() ?: '3') as Integer
                        def cephImage   = params.CEPH_IMAGE?.trim() ?: ''
                        def odfChannel  = env.RESOLVED_ODF_CHANNEL?.trim() ?: ''
                        def nightly     = params.ODF_NIGHTLY_INDEX?.trim() ?: ''
                        def sshKeyNames = params.SSH_KEY_NAMES?.trim() ?: 'ceph-qe-sa,ceph-qe-sa-svc'

                        def config = readYaml(file: 'configs/deployment.yaml')

                        config.cluster.ocp_version = env.RESOLVED_OCP_VERSION
                        config.cluster.ocp_channel = env.RESOLVED_OCP_CHANNEL

                        config.ibmcloud.region = params.IBM_REGION
                        config.ibmcloud.cos_region = 'au-syd'
                        config.ibmcloud.vpc_name = params.VPC_NAME

                        config.ibmcloud.master.count = masterCount
                        config.ibmcloud.worker.count = workerCount

                        config.ibmcloud.worker.data_volumes.capacity_gb = deviceSize
                        config.ibmcloud.worker.data_volumes.count = deviceCount

                        if (odfChannel) {
                            config.odf.channel = odfChannel
                        } else {
                            config.odf.channel = ''
                        }

                        if (nightly) {
                            config.odf.nightly_index_image = nightly
                        }

                        if (cephImage) {
                            config.odf.ceph_image = cephImage
                        }

                        if (sshKeyNames) {
                            config.ibmcloud.ssh_key_names = sshKeyNames.split(',').collect { it.trim() }.findAll { it }
                        }

                        config.odf.device_set_count = workerCount
                        config.odf.osd_size = "${deviceSize}Gi"

                        def configFile = 'configs/deployment.yaml'
                        writeYaml(
                            file: configFile,
                            data: config,
                            overwrite: true
                        )

                        echo 'Updated deployment.yaml:'
                        echo "  OCP version   : ${config.cluster.ocp_version}"
                        echo "  OCP channel   : ${config.cluster.ocp_channel}"
                        echo "  ODF channel   : ${config.odf.channel ?: '(default)'}"
                        echo "  Ceph image    : ${config.odf.ceph_image ?: '(none)'}"
                        echo "  IBM region    : ${config.ibmcloud.region}"
                        echo "  VPC           : ${config.ibmcloud.vpc_name}"
                        echo "  Masters       : ${config.ibmcloud.master.count}"
                        echo "  Workers       : ${config.ibmcloud.worker.count}"
                        echo "  Device size   : ${config.ibmcloud.worker.data_volumes.capacity_gb} GB"
                        echo "  Device count  : ${config.ibmcloud.worker.data_volumes.count} per worker"
                        echo "  SSH keys      : ${config.ibmcloud.ssh_key_names}"
                        echo "  OSD size      : ${config.odf.osd_size}"
                        if (nightly) {
                            echo "  ODF nightly   : ${nightly}"
                        }
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // Deploy OCP + ODF
        // ──────────────────────────────────────────────────────────
        stage("Deploy OCP + ODF") {
            steps {
                dir("ceph-interop") {
                    script {
                        echo "Deploying cluster: ${env.CLUSTER_NAME}"
                        try {
                            sh """
                                ${VENV_DIR}/bin/python3.12 run.py deploy \
                                    --cluster-name '${env.CLUSTER_NAME}' \
                                    --verbose
                            """
                            env.DEPLOY_PASSED = 'true'
                            echo "Cluster deployed successfully: ${env.CLUSTER_NAME}"
                        } catch (Exception deployErr) {
                            def oc = "work/clusters/${env.CLUSTER_NAME}/bin/oc"
                            def ns = "openshift-storage"

                            echo "============================================================"
                            echo "DEPLOY FAILED — collecting diagnostics from ${ns}"
                            echo "============================================================"

                            def diagCmds = [
                                "StorageCluster status"  : "${oc} get storagecluster ocs-storagecluster -n ${ns} -o yaml",
                                "CephCluster status"     : "${oc} get cephcluster -n ${ns} -o yaml",
                                "ODF CSV status"         : "${oc} get csv -n ${ns}",
                                "Pod status"             : "${oc} get pods -n ${ns} -o wide",
                                "Unhealthy pods"         : "${oc} get pods -n ${ns} --field-selector=status.phase!=Running,status.phase!=Succeeded",
                                "Pod restarts & errors"  : "${oc} get pods -n ${ns} -o jsonpath='{range .items[?(@.status.containerStatuses)]}{.metadata.name}{\"\\t\"}{range .status.containerStatuses[*]}{.name}{\" restarts=\"}{.restartCount}{\" ready=\"}{.ready}{\" \"}{end}{\"\\n\"}{end}'",
                                "Recent events"          : "${oc} get events -n ${ns} --sort-by=.lastTimestamp | tail -60",
                                "Subscription status"    : "${oc} get subscription -n ${ns} -o yaml",
                                "PV status (localblock)" : "${oc} get pv -l storage.openshift.com/owner-name=local-block --no-headers",
                            ]

                            diagCmds.each { label, cmd ->
                                echo "\n──── ${label} ────"
                                try {
                                    sh "${cmd} 2>&1 || true"
                                } catch (Exception ignored) {
                                    echo "(command failed or cluster unreachable)"
                                }
                            }

                            echo "\n============================================================"
                            echo "END OF DIAGNOSTICS"
                            echo "============================================================"

                            throw deployErr
                        }
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // Run IO Workloads
        // ──────────────────────────────────────────────────────────
        stage("Run IO Workloads") {
            steps {
                dir("ceph-interop") {
                    script {
                        def pvcCount = params.PVC_COUNT?.trim() ?: "1"
                        echo "Running IO workloads on cluster: ${env.CLUSTER_NAME} (pvc-count: ${pvcCount})"
                        sh """
                            ${VENV_DIR}/bin/python3.12 run.py workload \
                                --cluster-name '${env.CLUSTER_NAME}' \
                                --pvc-count ${pvcCount} \
                                --verbose
                        """
                        env.WORKLOAD_PASSED = 'true'
                        echo "IO workloads completed successfully: ${env.CLUSTER_NAME}"
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // ocs-ci: Clone test framework
        // ──────────────────────────────────────────────────────────
        stage("Clone ocs-ci") {
            steps {
                dir("ocs-ci") {
                    script {
                        def ob = params.OCS_CI_BRANCH?.trim() ?: 'master'
                        echo "ocs-ci repo  : '${params.OCS_CI_REPO}'"
                        echo "ocs-ci branch: '${ob}'"

                        git(
                            url: params.OCS_CI_REPO,
                            branch: ob,
                            credentialsId: "ceph-qe-sa-pat"
                        )
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // ocs-ci: Setup Python 3.11 environment
        // ──────────────────────────────────────────────────────────
        stage("Setup ocs-ci Environment") {
            steps {
                dir("ocs-ci") {
                    sh """
                        python3.11 --version
                        echo "Creating ocs-ci virtual environment at ${OCSCI_VENV_DIR}"

                        python3.11 -m venv ${OCSCI_VENV_DIR}
                        ${OCSCI_VENV_DIR}/bin/pip install --upgrade pip setuptools wheel
                        ${OCSCI_VENV_DIR}/bin/pip install -r requirements.txt

                        echo "ocs-ci environment setup complete"
                        echo "run-ci location: \$(ls -la ${OCSCI_VENV_DIR}/bin/run-ci)"
                    """
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // ocs-ci: Prepare runtime config, credentials, and pull-secret
        // ──────────────────────────────────────────────────────────
        stage("Prepare ocs-ci Config") {
            steps {
                dir("ocs-ci") {
                    script {
                        env.OCS_CI_VERSION = params.OCS_VERSION?.trim() ?: env.RESOLVED_OCS_VERSION
                        echo "ocs-ci OCS version: ${env.OCS_CI_VERSION}"

                        def clusterPath = "${env.WORKSPACE}/ceph-interop/work/clusters/${env.CLUSTER_NAME}/openshift"
                        def binDir = "${env.WORKSPACE}/ceph-interop/work/clusters/${env.CLUSTER_NAME}/bin"
                        env.OCSCI_CLUSTER_PATH = clusterPath

                        def runtimeConfig = [
                            AUTH: [
                                ibmcloud: [
                                    api_key: env.IBM_CLOUD_API_KEY,
                                    account_id: env.IBM_CLOUD_ACCOUNT_ID
                                ]
                            ],
                            RUN: [
                                bin_dir: binDir,
                                log_dir: "${env.WORKSPACE}/ocs-ci/ocs-ci-logs-${env.BUILD_NUMBER}"
                            ],
                            DEPLOYMENT: [
                                skip_download_client: true
                            ],
                            ENV_DATA: [
                                skip_ocs_deployment: true,
                                skip_ocp_deployment: true,
                                deployment_type: 'upi',
                                region: params.IBM_REGION
                            ]
                        ]
                        writeYaml(file: 'interop-runtime-config.yaml', data: runtimeConfig, overwrite: true)
                        echo "Wrote interop-runtime-config.yaml (bin_dir: ${binDir})"

                        withCredentials([file(credentialsId: 'ocs-pull-secret', variable: 'PULL_SECRET_FILE')]) {
                            sh """
                                mkdir -p data
                                cp "\${PULL_SECRET_FILE}" data/pull-secret
                                chmod 600 data/pull-secret
                                echo "pull-secret copied to ocs-ci/data/pull-secret"
                            """
                        }

                        sh '''
                            if ! command -v ibmcloud >/dev/null 2>&1; then
                                echo "ibmcloud CLI not found -- installing..."
                                curl -fsSL https://clis.cloud.ibm.com/install/linux | sh
                            fi
                            echo "ibmcloud CLI: $(ibmcloud --version | head -1)"
                        '''

                        sh """
                            if [ ! -f '${clusterPath}/auth/kubeconfig' ]; then
                                echo "ERROR: kubeconfig not found at ${clusterPath}/auth/kubeconfig"
                                exit 1
                            fi
                            echo "kubeconfig found at ${clusterPath}/auth/kubeconfig"
                        """

                        sh """
                            if [ ! -x '${binDir}/oc' ]; then
                                echo "ERROR: oc binary not found at ${binDir}/oc"
                                exit 1
                            fi
                            echo "oc binary: \$('${binDir}/oc' version --client 2>/dev/null | head -1)"
                        """
                    }
                }
            }
        }

        // ──────────────────────────────────────────────────────────
        // ocs-ci: Run tests (acceptance by default)
        // ──────────────────────────────────────────────────────────
        // run-ci options: see https://ocs-ci.readthedocs.io/en/latest/usage.html
        //   Required for this flow: --cluster-path (existing cluster / kubeconfig).
        //   We set --ocs-version (ODF); --ocsci-conf overlays IBM Cloud + skip OCP/ODF deploy.
        //   --html / --self-contained-html: pytest HTML report
        //   (Jenkins emailext attaches report.html; run-ci --email is not used).
        // ──────────────────────────────────────────────────────────
        stage("Run ocs-ci Tests") {
            steps {
                dir("ocs-ci") {
                    sh "mkdir -p ocs-ci-logs-${env.BUILD_NUMBER}"
                    sh """
                        ${OCSCI_VENV_DIR}/bin/run-ci \
                            --cluster-path '${env.OCSCI_CLUSTER_PATH}' \
                            --cluster-name '${env.CLUSTER_NAME}' \
                            ${params.OCS_CI_TESTS ?: '-m acceptance'} \
                            --ocsci-conf conf/deployment/baremetal/upi_1az_rhcos_nvme_intel_3m_3w.yaml \
                            --ocsci-conf interop-runtime-config.yaml \
                            --ocs-version '${env.OCS_CI_VERSION}' \
                            --skip-download-client \
                            --log-level DEBUG --collect-logs \
                            --html=ocs-ci-logs-${env.BUILD_NUMBER}/ocs-ci-test-report.html --self-contained-html \
                            --junit-xml=ocs-ci-logs-${env.BUILD_NUMBER}/ocs-ci-test-junit-results.xml \
                            tests/functional/
                    """
                }
            }
        }

    }

    post {
        always {
            script {
                if (env.PIPELINE_SKIP == 'true') {
                    currentBuild.result = 'NOT_BUILT'
                    echo "Pipeline skipped: ${currentBuild.description}"
                    return
                }

                def clusterName = env.CLUSTER_NAME ?: ""
                def hasCluster = clusterName ? true : false
                def venvDir = "${env.WORKSPACE}/ceph-interop/.venv"

                // ── Teardown ──
                if (hasCluster && fileExists("${venvDir}/bin/python3.12")) {
                    try {
                        dir("ceph-interop") {
                            echo "Tearing down cluster: ${clusterName}"
                            sh """
                                ${venvDir}/bin/python3.12 run.py teardown \
                                    --cluster-name '${clusterName}' \
                                    --verbose
                            """
                        }
                    } catch (Exception e) {
                        echo "Teardown failed: ${e.message}"
                    }
                } else {
                    echo "Skipping teardown: cluster=${clusterName ?: '(none)'}"
                }

                // ── Archive cluster artifacts ──
                try {
                    dir("ceph-interop") {
                        if (hasCluster) {
                            if (fileExists("configs/${clusterName}-state.json")) {
                                archiveArtifacts artifacts: "configs/${clusterName}-state.json"
                            }
                            sh """
                                if [ -d "work/clusters/${clusterName}" ]; then
                                    tar czf "cluster-artifacts-${clusterName}.tar.gz" \
                                        --exclude='bin' \
                                        -C work/clusters \
                                        "${clusterName}" 2>/dev/null || true
                                    echo "Created cluster-artifacts-${clusterName}.tar.gz"
                                else
                                    echo "Cluster directory work/clusters/${clusterName} not found -- skipping archive"
                                fi
                            """
                            if (fileExists("cluster-artifacts-${clusterName}.tar.gz")) {
                                archiveArtifacts artifacts: "cluster-artifacts-${clusterName}.tar.gz"
                            }
                            if (fileExists("work/clusters/${clusterName}/openshift/auth")) {
                                archiveArtifacts artifacts: "work/clusters/${clusterName}/openshift/auth/*"
                            }
                            if (fileExists("work/clusters/${clusterName}")) {
                                archiveArtifacts artifacts: "work/clusters/${clusterName}/workload-report-*.txt", allowEmptyArchive: true
                            }
                        } else {
                            echo "No cluster name available -- skipping cluster artifact archival"
                        }
                    }
                } catch (Exception e) {
                    echo "Artifact archival failed (non-fatal): ${e.message}"
                }

                // ── Archive ocs-ci test artifacts ──
                def logDir = "ocs-ci-logs-${env.BUILD_NUMBER}"
                try {
                    dir("ocs-ci") {
                        if (fileExists(logDir)) {
                            if (fileExists("${logDir}/ocs-ci-test-report.html")) {
                                archiveArtifacts artifacts: "${logDir}/ocs-ci-test-report.html"
                            }
                            if (fileExists("${logDir}/ocs-ci-test-junit-results.xml")) {
                                archiveArtifacts artifacts: "${logDir}/ocs-ci-test-junit-results.xml"
                            }
                            sh "tar czf ${logDir}.tar.gz --exclude='ocs-ci-test-*.html' --exclude='ocs-ci-test-*.xml' ${logDir}/ 2>/dev/null || true"
                            if (fileExists("${logDir}.tar.gz")) {
                                archiveArtifacts artifacts: "${logDir}.tar.gz"
                            }
                        } else {
                            echo "Skipping ocs-ci artifact archival: ${logDir} not found (run-ci may not have executed)"
                        }
                    }
                } catch (Exception e) {
                    echo "ocs-ci artifact archival failed (non-fatal): ${e.message}"
                }

                // ── Upload artifacts to IBM COS ──
                def cosRemote = "ceph-qe-cos"
                def cosBucket = "ceph-qe-logs"
                def cosBaseUrl = "https://10.8.128.2/cephci-jenkins/ibm-cos"
                def cosBasePath = "odf-interop/${env.BUILD_NUMBER}"
                def cosResultsUrl = ''
                try {
                    def hasRclone = sh(script: "rclone listremotes 2>/dev/null | grep -q '^${cosRemote}:'", returnStatus: true) == 0
                    if (!hasRclone) {
                        echo "rclone remote '${cosRemote}' not configured -- skipping COS upload"
                    } else {
                        def filesToUpload = []
                        if (hasCluster) {
                            def clusterTar = "ceph-interop/cluster-artifacts-${clusterName}.tar.gz"
                            if (fileExists(clusterTar)) { filesToUpload << clusterTar }
                        }
                        def ocsciTar = "ocs-ci/${logDir}.tar.gz"
                        if (fileExists(ocsciTar)) { filesToUpload << ocsciTar }
                        if (fileExists("ocs-ci/${logDir}/ocs-ci-test-report.html"))       { filesToUpload << "ocs-ci/${logDir}/ocs-ci-test-report.html" }
                        if (fileExists("ocs-ci/${logDir}/ocs-ci-test-junit-results.xml")) { filesToUpload << "ocs-ci/${logDir}/ocs-ci-test-junit-results.xml" }

                        if (filesToUpload) {
                            def uploadStart = System.currentTimeMillis()
                            for (f in filesToUpload) {
                                sh "rclone copy ${f} ${cosRemote}:${cosBucket}/${cosBasePath}/ --progress --transfers=8 --checkers=8"
                            }
                            def uploadSec = (System.currentTimeMillis() - uploadStart) / 1000
                            cosResultsUrl = "${cosBaseUrl}/${cosBasePath}/"
                            echo "COS upload complete: ${filesToUpload.size()} file(s) in ${uploadSec}s -- ${cosResultsUrl}"
                        }
                    }
                } catch (Exception e) {
                    echo "COS upload failed (non-fatal): ${e.message}"
                }

                // ── Publish JUnit results ──
                def testSummary = null
                try {
                    def junitFile = "ocs-ci/${logDir}/ocs-ci-test-junit-results.xml"
                    if (fileExists(junitFile)) {
                        def result = junit testResults: junitFile, allowEmptyResults: true
                        testSummary = [
                            total: result.totalCount,
                            pass:  result.passCount,
                            fail:  result.failCount,
                            skip:  result.skipCount
                        ]
                    }
                } catch (Exception e) {
                    echo "JUnit publish failed (non-fatal): ${e.message}"
                }

                // ── Email notification ──
                try {
                    sendOdfInteropEmail(
                        clusterName: clusterName, hasCluster: hasCluster,
                        testSummary: testSummary, cosResultsUrl: cosResultsUrl
                    )
                } catch (Exception e) {
                    echo "Email with test summary failed (${e.message}) -- retrying without summary"
                    try {
                        sendOdfInteropEmail(clusterName: clusterName, hasCluster: hasCluster)
                    } catch (Exception e2) {
                        echo "Email notification failed entirely: ${e2.message}"
                    }
                }

                // ── Cleanup credentials ──
                dir("ceph-interop") {
                    sh 'rm -f configs/credentials.yaml configs/pull-secret.json 2>/dev/null || true'
                }
                dir("ocs-ci") {
                    sh 'rm -f interop-runtime-config.yaml data/pull-secret 2>/dev/null || true'
                }
            }
        }
    }
}
