// Import shared library
@Library("ceph-qe-libs@main")_

// Global variables section
def buildInfo = [:]
def buildTag = "nightly"
def job = "listener"
def repoDc = "eu-de"
def buildType = ""
def buildVersion = ""


// Pipeline definition
pipeline {
    options {
        // Set build archieve policy
        buildDiscarder(logRotator(numToKeepStr: "30", daysToKeepStr: "30"))

        // Disable parallel execution
        disableConcurrentBuilds()
    }

    agent {
        // Use agent label
        label "infra"
    }

    stages {
        // Validate build details
        stage("Validate Params") {
            steps {
                script {
                    if ( ! params.TEST_KONFLUX_STRING_PARAM ) {
                        currentBuild.result = "ABORTED"
                        error(
                            "Mandatory parameter " +
                            "'TEST_KONFLUX_STRING_PARAM' not provided"
                        )
                    }
                }
            }
        }

        // Validate builds
        stage("Validate Builds") {
            steps {
                script {
                    // Get build info from message
                    buildInfo = validateKonfluxBuilds(
                        buildMessage: params.TEST_KONFLUX_STRING_PARAM
                    )

                    // Set build type & version
                    buildType = buildInfo.type.toUpperCase()
                    buildVersion = buildInfo.buildVersion
                }
            }
        }

        // Update builds to repo
        stage("Update Manifest") {
            steps {
                script {
                    writeToManifest(
                        buildInfo: buildInfo, buildTag: buildTag, job: job
                    )
                }
            }
        }

        // Sync container images
        stage("Sync Container Images") {
            steps {
                script {
                    // Sync all container images
                    buildInfo.images.each { image, url ->
                        echo "Syncing image ${image}: ${url}"
                        syncContainerImage(containerImage: url)
                    }
                }
            }
        }

        // Trigger BVT pipeline
        stage("Trigger BVT") {
            when {
                expression {
                    env.CEPH_BASE_CHANGED == "true"
                }
            }

            steps {
                script {
                    // Check for ceph version
                    def jobName = ""
                    def platform = ""
                    if (buildInfo.application == "ceph-7-1") {
                        jobName = "reef-bvt-ci"
                        platform = "rhel-9"
                    } else if (buildInfo.application == "ceph-8-1") {
                        jobName = "squid-bvt-ci"
                        platform = "rhel-9"
                    } else if (buildInfo.application in ["ceph-9-0", "ceph-9-1"]) {
                        jobName = "tentacle-bvt-ci"
                        platform = "rhel-10"
                    } else {
                        currentBuild.result = "ABORTED"
                        error("Unsupported Ceph version ${buildInfo.application}")
                    }

                    if (buildType.toLowerCase() == "redhat") {
                        buildType = "RH"
                    }

                    // Set Custom Configs & RHCS Ceph Repo
                    def customConfigs = ""
                    def cephBase = ""
                    buildInfo.images.each { image, url ->
                        if (image == "ceph-base") {
                            cephBase = url
                        } else {
                            customConfigs += "${image}=${url},"
                        }
                    }

                    // read manifest to get compose
                    repoBuild = readFromManifest(recipe: buildInfo.recipe, job: job)

                    // Create repo url and check if it is available in the manifest

                    def repoUrl = repoBuild?."${buildTag}"?.repositories?."${repoDc}"?."${platform}"
                    if (!repoUrl) {
                        error(
                            "Missing repo in manifest for tag=${buildTag}, " +
                            "dc=${repoDc}, platform=${platform}, recipe=${buildInfo.recipe}"
                        )
                    }

                    // Trigger BVT job
                    build ([
                        wait: false,
                        job: jobName,
                        parameters: [
                            string(
                                name: "BUILD_VERSION", value: buildVersion
                            ),
                            string(name: "RHEL_VERSION", value: platform),
                            string(name: "BUILD_TYPE", value: buildType),
                            string(
                                name: "REPO",
                                value: repoUrl
                            ),
                            string(name: "CONTAINER_IMAGE", value: cephBase),
                            string(
                                name: "CUSTOM_CONFIG", value: customConfigs
                            ),
                            booleanParam(name: "UPDATE_BVT_RESULTS", value: true)
                        ]
                    ])

                }
            }
        }
    }
}
