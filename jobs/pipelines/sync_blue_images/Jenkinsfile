// Synchronize the mirror repository with blue build
@Library("ceph-qe-libs@main") _

pipeline {
    agent { label "infra" }

    options {
        buildDiscarder(logRotator(numToKeepStr: "5", daysToKeepStr: "5"))
        timeout(time: 2, unit: 'HOURS')
    }

    stages {

        stage("Validate Input") {
            steps {
                script {
                    println("The list of container images provided " + params.BLUE_IMAGES)
                    if ( params.BLUE_IMAGES == null || params.BLUE_IMAGES.trim().isEmpty() ) {
                        error("No repository information was provided.")
                    }
                }
            }
        }

        stage("Syncrhonize") {
            steps {
                script { syncBlueImages(images: params.BLUE_IMAGES) }
            }
        }

        stage("Trigger BVT") {
            steps {
                script {
                    // Constants
                    final String IBM_CEPH_IMAGE_PATTERN = "icr.io/cp/ibm-ceph/ceph-"
                    final String EXCLUDED_IMAGE_PATTERN = "crimson"
                    final String DEFAULT_REGION = "eu-de"

                    // Return from this stage if not enabled
                    if ( ! params.TRIGGER_BVT ) {
                        println("Build Verification pipeline is not triggered by default.")
                        return
                    }

                    // Get the ceph-base image from the list. We are
                    // specifically checking for IBM Ceph image.
                    // Note: Crimson images are excluded as they are experimental/development builds
                    // and should not trigger BVT pipelines.
                    def cephBaseImage = ""

                    def images = params.BLUE_IMAGES.split("\r?\n")
                    images.each { image ->
                        def trimmedImage = image.trim()
                        if (
                            ( trimmedImage.contains(IBM_CEPH_IMAGE_PATTERN) ) &&
                            ( ! trimmedImage.toLowerCase().contains(EXCLUDED_IMAGE_PATTERN.toLowerCase()) )
                        ) {
                            cephBaseImage = trimmedImage
                            println("A match has been found: " + cephBaseImage)
                        }
                    }

                    // Override trigger if ceph-base was not provided
                    if ( cephBaseImage.isEmpty() ) {
                        println("Unable to find a matching IBM Storage Ceph base image.")
                        return
                    }

                    def imageInfo
                    try {
                        imageInfo = processCephBaseImage(cephBaseImage)
                    } catch (Exception e) {
                        println("Error processing ceph base image: ${e.message}")
                        currentBuild.result = 'UNSTABLE'
                        return
                    }

                    // Maintain consistency with Konflux trigger job
                    // Requires us to pass all said overrides instead of depending on qe-ceph-manifest
                    def buildInfo
                    try {
                        buildInfo = readFromManifest(
                            recipe: imageInfo.vendor + "/" + imageInfo.releaseVersion + ".yaml",
                            job: "sync-blue-ceph-images"
                        )
                    } catch (Exception e) {
                        println("Error reading manifest: ${e.message}")
                        currentBuild.result = 'UNSTABLE'
                        return
                    }

                    // Retrieve the bild details based on provided build type
                    def buildSection = buildInfo[params.BUILD_TYPE]
                    if ( !buildSection ) {
                        println("No manifest section found ${params.BUILD_TYPE}")
                        currentBuild.result = 'UNSTABLE'
                        return
                    }

                    // If ceph versions don't match let's abort as the ceph-base image is not synced
                    if ( buildSection?.version != imageInfo?.cephVersion ) {
                        println("The ceph version in recipe file and image don't match.")
                        return
                    }

                    // Gather the repoURL - use default region or from params if available
                    def region = params.REGION ?: DEFAULT_REGION
                    def repoURL = buildSection.repositories."${region}"?."${imageInfo.osPlatform}"

                    if ( !repoURL ) {
                        println("Repository URL not found for region: ${region}, platform: ${imageInfo.osPlatform}")
                        currentBuild.result = 'UNSTABLE'
                        return
                    }

                    // Gather the custom configs for images
                    def customConfigs = ""
                    buildSection.images.each { key, image ->
                        if ( key == "ceph-base" ) {
                            return  // continue in closure
                        }
                        customConfigs += "${key}=${image},"
                    }

                    // Remove trailing comma if present
                    if ( customConfigs.endsWith(",") ) {
                        customConfigs = customConfigs[0..-2]
                    }

                    // Validate custom configs
                    if ( customConfigs.isEmpty() ) {
                        println("Warning: No custom container images found in manifest")
                    }

                    // Trigger the Build Verification test
                    try {
                        build ([
                            wait: false,
                            propagate: false,
                            job: imageInfo.release + "-bvt-ci",
                            parameters: [
                                string(name: "BUILD_VERSION", value: imageInfo.releaseVersion),
                                string(name: "RHEL_VERSION", value: imageInfo.osPlatform),
                                string(name: "BUILD_TYPE", value: imageInfo.vendor.toUpperCase()),
                                string(name: "REPO", value: repoURL),
                                string(name: "CONTAINER_IMAGE", value: cephBaseImage),
                                string(name: "CUSTOM_CONFIG", value: customConfigs),
                                // params.BUILD_TYPE is passed as RELEASE as BVT understands build_type is ibm or RH
                                // they assume release is rc, nightly, etc
                                string(name: "RELEASE", value: params.BUILD_TYPE),
                                booleanParam(name: "UPDATE_BVT_RESULTS", value: true),
                                booleanParam(name: "TRIGGER_DATA_FOUNDATION_INTEROP", value: true)
                            ]
                        ])
                        println("Successfully triggered BVT pipeline for ${imageInfo.release}")
                    } catch (Exception e) {
                        println("Error triggering BVT pipeline: ${e.message}")
                        currentBuild.result = 'UNSTABLE'
                    }
                }
            }
        }
    }
}
