// Synchronize the mirror repository with blue build
@Library("ceph-qe-libs@main")

pipeline {
    agent { label "infra" }

    options {
        buildDiscarder(logRotator(numToKeepStr: "5", daysToKeepStr: "5"))
    }

    stages {

        stage("Validate Input") {
            steps {
                script {
                    if ( params.BLUE_IMAGES == null || params.BLUE_IMAGES.trim().isEmpty()) {
                        error("No repository information was provided.")
                    }
                }
            }
        }

        stage("Syncrhonize") {
            steps {
                script { syncBlueImages(images: params.BLUE_IMAGES) }
            }
        }
    }
}
