// 2026-02-14 Generated by IBM Bob
// Synchronize container images from qe-ceph-manifest repository
@Library("ceph-qe-libs@main") _

pipeline {
    agent { label "infra" }

    options {
        buildDiscarder(logRotator(numToKeepStr: "10", daysToKeepStr: "30"))
        timestamps()
        timeout(time: 2, unit: 'HOURS')
    }

    stages {
        stage("Validate Input") {
            steps {
                script {
                    echo "=== Input Parameters ==="
                    echo "Manifest Branch: ${params.MANIFEST_BRANCH}"
                    echo "Release Version: ${params.RELEASE_VERSION ?: 'All available releases'}"
                    echo "Vendor: ${params.VENDOR ?: 'None (will skip sync)'}"
                    echo "Dry Run: ${params.DRY_RUN}"
                    echo "========================"

                    // Check if vendor is provided
                    if (!params.VENDOR || params.VENDOR.trim().isEmpty()) {
                        echo "Warning: No vendor specified. Pipeline will skip image sync."
                        currentBuild.result = "SUCCESS"
                        return
                    }

                    // Validate vendor list (comma-separated)
                    def vendorList = params.VENDOR.split(',').collect { it.trim() }.findAll { it }
                    def validVendors = ["ibm", "redhat", "ceph"]
                    def invalidVendors = vendorList.findAll { !validVendors.contains(it) }

                    if (invalidVendors) {
                        error("Invalid vendor(s): ${invalidVendors.join(', ')}. Valid vendors are: ${validVendors.join(', ')}")
                    }

                    // Validate release version format if provided
                    if (params.RELEASE_VERSION && params.RELEASE_VERSION.trim()) {
                        if (!params.RELEASE_VERSION.matches(/^\d+\.\d+$/)) {
                            error("Invalid RELEASE_VERSION format. Expected format: X.Y (e.g., 9.0)")
                        }
                    }
                }
            }
        }

        stage("Sync Images") {
            steps {
                script {
                    echo "\n=== Starting Image Synchronization ==="

                    try {
                        // Call the main sync function
                        syncManifestImages(
                            manifestBranch: params.MANIFEST_BRANCH,
                            releaseVersion: params.RELEASE_VERSION,
                            vendor: params.VENDOR,
                            dryRun: params.DRY_RUN
                        )

                        echo "\n✓ Image synchronization completed successfully"

                    } catch (Exception e) {
                        echo "\n✗ Image synchronization failed: ${e.getMessage()}"
                        currentBuild.result = "FAILURE"
                        throw e
                    }
                }
            }
        }

        stage("Summary") {
            steps {
                script {
                    echo "\n=== Sync Summary ==="
                    echo "Build Status: ${currentBuild.result ?: 'SUCCESS'}"
                    echo "Release Version: ${params.RELEASE_VERSION ?: 'All available releases'}"
                    echo "Vendor: ${params.VENDOR ?: 'None'}"
                    echo "Dry Run: ${params.DRY_RUN}"

                    if (!params.VENDOR || params.VENDOR.trim().isEmpty()) {
                        echo "\nNo vendor specified - sync was skipped."
                    } else if (params.DRY_RUN) {
                        echo "\nNote: This was a dry run. No images were actually synced."
                    } else {
                        echo "\nImages have been synced to: nginx-vm-01.ceph.qe.lab:5000"
                    }
                    echo "===================="
                }
            }
        }
    }

    post {
        success {
            script {
                echo "\n✓ Pipeline completed successfully"
            }
        }
        failure {
            script {
                echo "\n✗ Pipeline failed"
            }
        }
        always {
            script {
                // Cleanup workspace if needed
                echo "\nCleaning up workspace..."
                cleanWs(
                    deleteDirs: true,
                    patterns: [
                        [pattern: 'manifest-*', type: 'INCLUDE']
                    ]
                )
            }
        }
    }
}
