@Library("ceph-qe-libs@main")_

def job = "upgrade"
def jobConfigs = [:]
def skipSosReport = true
def skipSubscription = true

// Compare version v against target
def versionComparison(v, target) {
    return (v.tokenize('.')*.toInteger() <=> target.tokenize('.')*.toInteger()) >= 0
}

// If BUILD_VERSION is lower than the introduction version, the component is skipped.
def allowComponent = { comp, buildVersion, buildType ->
    if (!params[comp.toUpperCase()]) return false
    switch (comp.toLowerCase()) {
        case "rados":     return versionComparison(buildVersion, "5.1")
        case "nfs":       return versionComparison(buildVersion, "7.1")
        case "nvmeotcp":  return versionComparison(buildVersion, "7.1") && (buildType == "IBM")
        case "smb":       return versionComparison(buildVersion, "8.1")
        default:          return true
    }
}

// Execute a single testsuite under a component
def runSuite = { suite, comp, buildVersion, buildType ->
    def stageName = "${comp}-${suite.name}"
    def logDir = "${jobConfigs.logDir}/${stageName}"
    def prefix = "${params.PREFIX}-${env.BUILD_NUMBER}-${generatePrefixString()}"

    stage(stageName) {
        // Delay before provisioning cloud resources — avoids mass simultaneous API hits
        sleep time: 60, unit: 'SECONDS'

        try {
            execTestSuites(
                gitDir: jobConfigs.gitDir,
                venvDir: jobConfigs.venvDir,
                instanceName: prefix,
                cloudType: jobConfigs.cloudType,
                rhBuild: buildVersion,
                platform: jobConfigs.platform,
                logDir: logDir,
                globalConf: suite.global_conf,
                suite: suite.suite,
                ibmcCredFile: jobConfigs.ibmcCredFile,
                inventory: jobConfigs.inventory,
                logLevel: params.LOG_LEVEL,
                customConfig: params.CUSTOM_CONFIG,
                buildType: buildType,
                enableFipsMode: params.ENABLE_FIPS_MODE,
                enableFirewall: params.ENABLE_FIREWALL,
                rhsCephRepo: params.REPO,
                hotfixRepo: params.HOTFIX_REPO,
                containerImage: params.CONTAINER_IMAGE,
                additionalArgs: params.ADDITIONAL_ARGS,
                vmFlavor: params.VM_FLAVOR,
                skipSosReport: skipSosReport,
                vpcName: params.VPC_NAME,
                skipSubscription: skipSubscription
            )
        } finally {
            cleanupCluster(
                gitDir: jobConfigs.gitDir,
                venvDir: jobConfigs.venvDir,
                cloudType: jobConfigs.cloudType,
                instanceName: prefix,
                ibmcCredFile: jobConfigs.ibmcCredFile,
                logLevel: params.LOG_LEVEL,
                vpcName: params.VPC_NAME
            )
        }
    }
}

// Execute all suites of a component — in parallel
def runComponent = { comp, buildVersion, buildType ->
    stage("Component: ${comp}") {
        def suites = fetchTestSuites(
            rhBuild: buildVersion,
            fg: comp,
            job: job,
            platform: jobConfigs.platform,
            cloudType: jobConfigs.cloudType,
            buildType: buildType
        )?.upgrade?.suites ?: []

        if (!suites) {
            echo "No suites found for ${comp}"
            return
        }

        def suiteMap = [:]
        suites.each { suite ->
            suiteMap["${comp}-${suite.name}"] = {
                runSuite(suite, comp, buildVersion, buildType)
            }
        }

        catchError(buildResult: "SUCCESS", stageResult: "FAILURE") {
            parallel suiteMap
        }
    }
}

pipeline {
    agent { label "agents" }

    options {
        buildDiscarder(logRotator(numToKeepStr: "10", daysToKeepStr: "30"))
        timeout(time: 24, unit: "HOURS")
    }

    stages {

        stage("Validate") {
            steps {
                script {
                    jobConfigs = generateJobConfigs(job: job)
                    echo "Validation successful"
                }
            }
        }

        stage("Setup") {
            steps {
                script {
                    setupCephCiRepo(
                        python: jobConfigs.python,
                        venvDir: jobConfigs.venvDir,
                        gitUrl: params.CEPHCI_REPO,
                        gitDir: jobConfigs.gitDir,
                        gitBranch: params.BRANCH,
                        cloudType: jobConfigs.cloudType,
                        ibmcCredFile: jobConfigs.ibmcCredFile
                    )
                }
            }
        }

        stage("Execute Components") {
            steps {
                script {
                    def buildVersion = params.BUILD_VERSION
                    def buildType = params.BUILD_TYPE
                    def inputComponents = params.components ?: []

                    for (comp in inputComponents) {

                        if (!allowComponent(comp, buildVersion, buildType)) {
                            echo "Skipped component: ${comp} (gates not satisfied)"
                            continue
                        }

                        echo "Starting Component: ${comp}"

                        catchError(buildResult: "SUCCESS", stageResult: "FAILURE") {
                            runComponent(comp, buildVersion, buildType)
                        }

                        echo "Completed Component: ${comp}"
                        sleep time: 120, unit: 'SECONDS'  // avoid IBM API rate spike
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                publishTestResults(
                    cephVersion: jobConfigs.cephVersion,
                    rhsCephRepo: params.REPO,
                    containerImage: params.CONTAINER_IMAGE,
                    buildType: params.BUILD_TYPE,
                    rhBuild: params.BUILD_VERSION,
                    platform: jobConfigs.platform,
                    cloudType: jobConfigs.cloudType,
                    logDir: jobConfigs.logDir,
                    resultsDir: jobConfigs.resultsDir,
                    resultsSummary: jobConfigs.resultsSummary,
                    artifacts: jobConfigs.artifacts,
                    emailBody: jobConfigs.emailBody,
                    emailAddr: params.EMAIL_ADDRESS,
                    rpLaunchUrl: jobConfigs.rpLaunchUrl,
                    rpLaunchName: jobConfigs.rpLaunchName,
                    rpLaunchDesc: jobConfigs.rpLaunchDesc,
                    rpLaunchAttributes: jobConfigs.rpLaunchAttributes,
                    rpProjectName: jobConfigs.rpProjectName
                )
            }
        }
    }
}
