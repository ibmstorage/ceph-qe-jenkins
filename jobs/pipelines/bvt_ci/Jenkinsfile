// Import shared library
@Library("ceph-qe-libs@main") _

// Set job parameters
def job = "bvt"
def fg = "common"
def jobConfigs = [:]

// Set suite parameters
def suites = [:]
def testSuitesMap = [:]
def skipSosReport = true

// Pipeline definition
pipeline {
    options {
        // Set build archieve policy
        buildDiscarder(logRotator(numToKeepStr: "10", daysToKeepStr: "30"))
    }

    agent {
        // Use agents-aws agent for AWS cloud, agents for IBM Cloud
        label "${params.CLOUD_TYPE == 'aws' ? 'agents-aws' : 'agents'}"
    }

    stages {
        stage("Validate") {
            steps {
                script {
                    // Validate mandatory parameters
                    jobConfigs = generateJobConfigs(job: job)

                    // Debug
                    echo "Parameters validated successfully ..."
                }
            }
        }

        stage("Setup") {
            steps {
                script {
                    // Setup Ceph CI repository and virtual environment
                    setupCephCiRepo(
                        python: jobConfigs.python,
                        venvDir: jobConfigs.venvDir,
                        gitUrl: jobConfigs.gitUrl,
                        gitDir: jobConfigs.gitDir,
                        gitBranch: jobConfigs.gitBranch,
                        cloudType: jobConfigs.cloudType,
                        ibmcCredFile: jobConfigs.ibmcCredFile,
                        credentialId: jobConfigs.credentialId
                    )

                    // Debug
                    echo "Ceph CI repository setup completed successfully ..."
                }
            }
        }

        stage("Fetch Suites") {
            steps {
                script {
                    // Get suites for given FG & Component
                    suites = fetchTestSuites(
                        rhBuild: jobConfigs.rhBuild,
                        fg: fg,
                        job: job,
                        platform: jobConfigs.platform,
                        cloudType: jobConfigs.cloudType,
                        buildType: jobConfigs.buildType,
                        python: "${jobConfigs.gitDir}/${jobConfigs.venvDir}/bin/python"
                    )
                }
            }
        }

        stage("Get Stages") {
            steps {
                script {
                    // Iterate over suite list
                    suites.bvt.suites.each { suite ->
                        // Prioritize test-level global_conf over stage-level globalConf
                        def effectiveGlobalConf = suite.global_conf ?: suites.bvt.metadata?.globalConf

                        // Prioritize test-level inventory over default inventory
                        def effectiveInventory = suite.inventory ?: jobConfigs.inventory

                        // Debug
                        echo "Executing suite: ${suite.suite} with config: ${effectiveGlobalConf}, inventory: ${effectiveInventory}"

                        // Create stages based on test suite
                        testSuitesMap[suite.name] = {
                            stage(suite.name) {
                                // Set log directory
                                def logDir = [jobConfigs.logDir, suite.name].join("/")

                                // Generate a random prefix for resources
                                def prefix = "${jobConfigs.prefix.take(6)}${env.BUILD_NUMBER}-${generatePrefixString()}"

                                try {
                                    // Execute the test job
                                    execTestSuites(
                                        gitDir: jobConfigs.gitDir,
                                        venvDir: jobConfigs.venvDir,
                                        instanceName: prefix,
                                        cloudType: jobConfigs.cloudType,
                                        product: jobConfigs.product,
                                        platform: jobConfigs.platform,
                                        release: jobConfigs.release,
                                        logDir: logDir,
                                        globalConf: effectiveGlobalConf,
                                        suite: suite.suite,
                                        ibmcCredFile: jobConfigs.ibmcCredFile,
                                        inventory: effectiveInventory,
                                        logLevel: jobConfigs.logLevel,
                                        customConfig: jobConfigs.customConfig,
                                        buildType: jobConfigs.buildType,
                                        enableFipsMode: jobConfigs.enableFipsMode,
                                        enableFirewall: jobConfigs.enableFirewall,
                                        rhsCephRepo: jobConfigs.rhsCephRepo,
                                        hotfixRepo: jobConfigs.hotfixRepo,
                                        containerImage: jobConfigs.containerImage,
                                        additionalArgs: jobConfigs.additionalArgs,
                                        vmFlavor: suite.vm_size ?: jobConfigs.vmFlavor,
                                        skipSosReport: skipSosReport,
                                        vpcName: jobConfigs.vpcName,
                                        skipSubscription: jobConfigs.skipSubscription,
                                        manifestSection: jobConfigs.manifestSection
                                    )

                                    // Debug
                                    echo "Test execution for ${suite.name} completed successfully."
                                } catch (Exception e) {
                                    echo "Suite ${suite.name} failed: ${e.message}"
                                    currentBuild.result = 'UNSTABLE'
                                } finally {
                                    // Cleanup configs generated
                                    cleanupCluster(
                                        gitDir: jobConfigs.gitDir,
                                        venvDir: jobConfigs.venvDir,
                                        cloudType: jobConfigs.cloudType,
                                        instanceName: prefix,
                                        ibmcCredFile: jobConfigs.ibmcCredFile,
                                        logLevel: jobConfigs.logLevel,
                                        vpcName: jobConfigs.vpcName
                                    )
                                }
                            }
                        }
                    }
                }
            }
        }

        stage("Execute Suites") {
            steps {
                script {
                    // Execute all the test suites in parallel
                    parallel testSuitesMap
                }
            }
        }
    }

    post {
        always {
            script {
                try {
                    def result = currentBuild.currentResult ?: currentBuild.result
                    def cephImage = jobConfigs.containerImage?.toString()?.trim()
                    def buildType = params.BUILD_TYPE?.toLowerCase()

                    echo "Check for Data Foundation interop trigger (BUILD_TYPE=${buildType})"

                    if (result == 'SUCCESS' && cephImage &&
                        params.TRIGGER_DATA_FOUNDATION_INTEROP &&
                        buildType in ['rh', 'ibm']) {
                        def downstreamJob = (buildType == 'ibm') ? 'fdf-interop' : 'odf-interop'
                        def triggered = build(
                            job: downstreamJob,
                            wait: false,
                            parameters: [
                                string(name: 'CEPH_IMAGE', value: cephImage),
                                string(name: 'RHCS_BUILD_VERSION', value: (jobConfigs.rhBuild ?: params.BUILD_VERSION ?: '').toString()),
                            ]
                        )
                        echo "Triggered downstream job '${downstreamJob}' (queued or running): build #${triggered?.number ?: 'n/a'}"
                    } else {
                        echo "Skipping Data Foundation interop downstream " +
                            "| result=${result} BUILD_TYPE=${buildType} " +
                            "TRIGGER_DATA_FOUNDATION_INTEROP=${params.TRIGGER_DATA_FOUNDATION_INTEROP} " +
                            "image=${cephImage ? 'set' : 'empty'}"
                    }
                } catch (Exception e) {
                    echo "Interop trigger failed (non-fatal; publishTestResults still runs): ${e.message}"
                }

                echo "Send results to ${params.EMAIL_ADDRESS}"
                // The build team requested to trigger SPS pipeline only for blue builds.
                def boolPublishSPS = params.BUILD_TYPE?.toLowerCase() == "ibm"

                publishTestResults(
                    cephVersion: jobConfigs.cephVersion,
                    rhsCephRepo: jobConfigs.rhsCephRepo,
                    containerImage: jobConfigs.containerImage,
                    buildType: jobConfigs.buildType,
                    rhBuild: jobConfigs.rhBuild,
                    platform: jobConfigs.platform,
                    release: params.RELEASE,
                    cloudType: jobConfigs.cloudType,
                    logDir: jobConfigs.logDir,
                    resultsDir: jobConfigs.resultsDir,
                    resultsSummary: jobConfigs.resultsSummary,
                    artifacts: jobConfigs.artifacts,
                    emailBody: jobConfigs.emailBody,
                    emailAddr: params.EMAIL_ADDRESS,
                    rpLaunchUrl: jobConfigs.rpLaunchUrl,
                    rpLaunchName: jobConfigs.rpLaunchName,
                    rpLaunchDesc: jobConfigs.rpLaunchDesc,
                    rpLaunchAttributes: jobConfigs.rpLaunchAttributes,
                    rpProjectName: jobConfigs.rpProjectName,
                    triggerSPS: boolPublishSPS
                )
            }
        }

        cleanup {
            script {
                // cleanup logic
                echo "Cleanup completed successfully ..."
            }
        }
    }
}
