<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title></title>
    <style>
        table.full-table{
                font-family: arial, sans-serif;
                border-collapse: collapse;
                width: 100%;
            }
        td, th {
            border: 1px solid #050505;
            text-align: left;
            padding: 8px;
        }
        p { margin:0 }
        table, th, td {
            border: 1px solid #050505;
            border-collapse: collapse;
        }
        caption {
            font-size: 150%;
            font-weight: bold;
        }
        .indent-underline {
            text-indent: 85px;
            text-decoration: underline;
        }
        .underline {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <br>
    <table style="width:1000px">
        <caption style="background-color: #A5A5A5; border: 1px solid black; height: 40px; align-items: center; justify-content: center;">TEST ARTIFACTS</caption>
            <tr>
                <td style="background-color: #D4D7D4;"><b>Build Type</b></td>
                <td>{{BuildType}}</td>
            </tr>
            <tr>
                <td style="background-color: #D4D7D4;"><b>Ceph Version</b></td>
                <td>{{CephVersion}}</td>
            </tr>
            <tr>
                <td style="background-color: #D4D7D4;"><b>Release</b></td>
                <td>{{Release}}</td>
            </tr>
            <tr>
                <td style="background-color: #D4D7D4;"><b>RHEL Version</b></td>
                <td>{{RhelVersion}}</td>
            </tr>
            <tr>
                <td style="background-color: #D4D7D4;"><b>Cloud</b></td>
                <td>{{CloudType}}</td>
            </tr>
            <tr>
                <td style="background-color: #D4D7D4;"><b>Job</b></td>
                <td><a href="{{Job}}">{{jobName}}</a></td>
            </tr>
            <tr>
                <td style="background-color: #D4D7D4;"><b>Repo</b></td>
                <td><a href="{{Repo}}">{{(Repo.strip('/')).split('/').pop()}}</a></td>
            </tr>
            <tr>
                <td style="background-color: #D4D7D4;"><b>Container</b></td>
                <td>{{Container}}</td>
            </tr>
            {% if ResultsURL %}
            <tr>
                <td style="background-color: #D4D7D4;"><b>Results URL</b></td>
                <td>
                <p style="margin:0 0 4px 0;"> <a href="https://10.8.128.2/cephci-jenkins/ibm-cos/{{ResultsURL}}">Magna002.ceph.redhat.com</a></p>
                <p style="margin:0;"> <a href="http://10.64.24.74/logs/ceph-qe-logs/{{ResultsURL}}">Tucson lab</a></p>
                <p style="margin:10px 0 0 0; font-size: 90%; color: #444;">Note: The Result URL might not be available immediately; it normally takes up to 30 min to sync results.</p>
                </td>
            </tr>
            {% endif %}
    </table>
    {% if Results %}
        <br>
        <table style="width:1000px">
            <caption style="background-color: #A5A5A5; border: 1px solid black; height: 40px; align-items: center; justify-content: center;">TEST SUMMARY</caption>
            <tr>
                <th style="text-align: center; background-color: #D4D7D4;"><b>Test Suite</b></th>
                <th style="text-align: center; background-color: #D4D7D4;"><b>TIME</b></th>
                <th style="text-align: center; background-color: #D4D7D4;"><b>TOTAL</b></th>
                <th style="text-align: center; background-color: #D4D7D4;"><b>PASSED</b></th>
                <th style="text-align: center; background-color: #D4D7D4;"><b>FAILED</b></th>
                <th style="text-align: center; background-color: #D4D7D4;"><b>SKIPPED</b></th>
                <th style="text-align: center; background-color: #D4D7D4;"><b>COMMENTS</b></th>
            </tr>
            {% for item in Results %}
                <tr style="text-align: center; {% if item.total == 0 %}background-color: #ECECC3; {% elif item.status == 'FAIL' %}background-color: #FCD0D0;{% else %}background-color: #DDFFDD;{% endif %}">
                    <td><b>{{item.name}}</b></td>
                    <td style="text-align: center">{{item.time}} min</td>
                    <td style="text-align: center">{{item.total}}</td>
                    <td style="text-align: center">{{item.passed}}</td>
                    <td style="text-align: center">{{item.failed}}</td>
                    <td style="text-align: center">{{item.skipped}}</td>
                    <td style="text-align: center">{{item.comments}}</td>
                </tr>

                {% if item.testcases %}
                    <tr>
                        <td colspan="7">
                            <table style="width:1000px">
                                <tr>
                                    <th style="text-align: center; background-color: #D4D7D4;"><b>Test Case</b></th>
                                    <th style="text-align: center; background-color: #D4D7D4;"><b>Status</b></th>
                                    <th style="text-align: center; background-color: #D4D7D4;"><b>Time (sec)</b></th>
                                </tr>

                                {% for tc in item.testcases %}
                                    <tr style="text-align:center; {% if tc.status == 'Failed' %}background-color: #FCD0D0;{% else %}background-color: #DDFFDD;{% endif %}">
                                        <td>{{ tc.name }}</td>
                                        <td>{{ tc.status }}</td>
                                        <td>{{ tc.time }}</td>
                                    </tr>
                                {% endfor %}
                            </table>
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
        </table>
    {% endif %}
</body>
</html>
